<roblox xmlns:xmime="http://schemas.microsoft.com/appv/2006/xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX51"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX52"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX15"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX9"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">BaitConfig</string><ProtectedString name="Source">--!strict
-- Bait catalog. Bait is consumed per cast and bought with Doubloons at the
-- market dock (never Pearls — keep the economy free of pay-to-win).

local Types = require(script.Parent.Parent.Types)

local BaitConfig = {}

local Baits: { [string]: Types.BaitDef } = {
	Worm = {
		id = "Worm",
		displayName = "Worm",
		cost = 5,
		luckBonus = 0.02,
		biteSpeedMultiplier = 0.9,
		description = "A classic. Fish respect tradition.",
	},
	Shrimp = {
		id = "Shrimp",
		displayName = "Shrimp",
		cost = 20,
		luckBonus = 0.05,
		biteSpeedMultiplier = 0.85,
		description = "Irresistible to mid-tier fish.",
	},
	Squid = {
		id = "Squid",
		displayName = "Squid Chunk",
		cost = 60,
		luckBonus = 0.09,
		biteSpeedMultiplier = 0.8,
		description = "Deep water fish can smell it a mile away.",
	},
	GlowGrub = {
		id = "GlowGrub",
		displayName = "Glow Grub",
		cost = 150,
		luckBonus = 0.14,
		biteSpeedMultiplier = 0.75,
		description = "Bioluminescent bait for the darkest depths.",
	},
}
BaitConfig.Baits = Baits

function BaitConfig.getBait(baitId: string?): Types.BaitDef?
	if baitId == nil then
		return nil
	end
	return BaitConfig.Baits[baitId]
end

return BaitConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">BattlePassConfig</string><ProtectedString name="Source">--!strict
-- Seasonal battle pass. Bump SEASON.number and swap the tier table each season;
-- DataService resets per-season progress automatically when the number changes.

local Types = require(script.Parent.Parent.Types)

local BattlePassConfig = {}

BattlePassConfig.SEASON = {
	number = 1,
	name = "Maiden Voyage",
}

-- xpRequired is CUMULATIVE. Rewards reference ids from Bait/Monetization configs.
local Tiers: { Types.BattlePassTier } = {
	{ xpRequired = 0, freeReward = { kind = "Doubloons", amount = 50 } },
	{
		xpRequired = 100,
		freeReward = { kind = "Bait", itemId = "Worm", amount = 10 },
		premiumReward = { kind = "Pearls", amount = 25 },
	},
	{
		xpRequired = 250,
		freeReward = { kind = "Doubloons", amount = 150 },
		premiumReward = { kind = "RodSkin", itemId = "Coral" },
	},
	{ xpRequired = 500, freeReward = { kind = "Bait", itemId = "Shrimp", amount = 10 } },
	{
		xpRequired = 900,
		freeReward = { kind = "Doubloons", amount = 400 },
		premiumReward = { kind = "Pearls", amount = 50 },
	},
	{
		xpRequired = 1400,
		freeReward = { kind = "Bait", itemId = "Squid", amount = 8 },
		premiumReward = { kind = "BoatSkin", itemId = "Candy" },
	},
	{ xpRequired = 2000, freeReward = { kind = "Doubloons", amount = 800 } },
	{
		xpRequired = 2800,
		freeReward = { kind = "Bait", itemId = "GlowGrub", amount = 6 },
		premiumReward = { kind = "Pet", itemId = "Seagull" },
	},
	{
		xpRequired = 3800,
		freeReward = { kind = "Doubloons", amount = 1500 },
		premiumReward = { kind = "Pearls", amount = 100 },
	},
	{
		xpRequired = 5000,
		freeReward = { kind = "Doubloons", amount = 3000 },
		premiumReward = { kind = "BoatSkin", itemId = "KrakenWrap" },
	},
}
BattlePassConfig.Tiers = Tiers

return BattlePassConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">BoatConfig</string><ProtectedString name="Source">--!strict
-- The 10-tier boat ladder, rowboat -&gt; luxury cruise liner.
-- `cost` is the price to upgrade INTO that tier from the previous one.
-- `appearance` is a hint for the placeholder hull the server builds; replace
-- with real models in Studio (see README "Manual Studio Work").

local Types = require(script.Parent.Parent.Types)

local BoatConfig = {}

local Tiers: { Types.BoatTierDef } = {
	{
		tier = 1,
		displayName = "Leaky Rowboat",
		cost = 0,
		speed = 14,
		storage = 8,
		rodSlots = 1,
		description = "It floats. Mostly.",
		appearance = { size = Vector3.new(4, 1.5, 8), color = Color3.fromRGB(110, 80, 50) },
	},
	{
		tier = 2,
		displayName = "Patched Dinghy",
		cost = 500,
		speed = 18,
		storage = 15,
		rodSlots = 1,
		description = "Fresh planks, fewer leaks.",
		appearance = { size = Vector3.new(4.5, 1.8, 9), color = Color3.fromRGB(130, 95, 60) },
	},
	{
		tier = 3,
		displayName = "Coastal Skiff",
		cost = 2_000,
		speed = 24,
		storage = 25,
		rodSlots = 1,
		description = "First boat sturdy enough for the Open Ocean.",
		appearance = { size = Vector3.new(5, 2, 11), color = Color3.fromRGB(160, 160, 170) },
	},
	{
		tier = 4,
		displayName = "Fishing Sloop",
		cost = 6_000,
		speed = 28,
		storage = 40,
		rodSlots = 2,
		description = "A proper working boat with a second rod mount.",
		appearance = { size = Vector3.new(6, 2.5, 14), color = Color3.fromRGB(200, 200, 210) },
	},
	{
		tier = 5,
		displayName = "Trawler",
		cost = 15_000,
		speed = 30,
		storage = 70,
		rodSlots = 2,
		description = "Smells like fish. That's the point.",
		appearance = { size = Vector3.new(7, 3, 17), color = Color3.fromRGB(60, 90, 140) },
	},
	{
		tier = 6,
		displayName = "Storm Runner",
		cost = 40_000,
		speed = 38,
		storage = 90,
		rodSlots = 2,
		description = "Reinforced hull rated for the Storm Zone.",
		appearance = { size = Vector3.new(7, 3.5, 19), color = Color3.fromRGB(45, 45, 55) },
	},
	{
		tier = 7,
		displayName = "Deep Sea Cutter",
		cost = 90_000,
		speed = 42,
		storage = 130,
		rodSlots = 3,
		description = "Sonar, spotlights, and a third rod mount.",
		appearance = { size = Vector3.new(8, 4, 22), color = Color3.fromRGB(30, 60, 70) },
	},
	{
		tier = 8,
		displayName = "Trench Explorer",
		cost = 200_000,
		speed = 46,
		storage = 180,
		rodSlots = 3,
		description = "Pressure-rated rigging opens the Deep Trench.",
		appearance = { size = Vector3.new(9, 4.5, 25), color = Color3.fromRGB(20, 30, 45) },
	},
	{
		tier = 9,
		displayName = "Coastal Yacht",
		cost = 450_000,
		speed = 52,
		storage = 250,
		rodSlots = 4,
		description = "Half workboat, half status symbol.",
		appearance = { size = Vector3.new(10, 5, 30), color = Color3.fromRGB(240, 240, 245) },
	},
	{
		tier = 10,
		displayName = "Luxury Cruise Liner",
		cost = 1_000_000,
		speed = 55,
		storage = 400,
		rodSlots = 4,
		description = "Hosts NPC passengers for passive ticket income. You made it, captain.",
		appearance = { size = Vector3.new(14, 8, 45), color = Color3.fromRGB(250, 250, 255) },
	},
}
BoatConfig.Tiers = Tiers

function BoatConfig.getTier(tier: number): Types.BoatTierDef?
	return BoatConfig.Tiers[tier]
end

BoatConfig.MAX_TIER = #BoatConfig.Tiers

return BoatConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">FishConfig</string><ProtectedString name="Source">--!strict
-- Master fish table. Rarity is rolled first (per-zone weights in ZoneConfig),
-- then a fish of that rarity whose `zones` list includes the current zone.
-- Sell price = baseValue * rarityMult * weightFactor * zone payout * market demand.

local Types = require(script.Parent.Parent.Types)

local FishConfig = {}

-- Ordered rarest-last; UI and luck math both rely on this order.
local RarityOrder: { Types.Rarity } = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }
FishConfig.RARITY_ORDER = RarityOrder

local RarityInfo: { [Types.Rarity]: { valueMult: number, color: Color3 } } = {
	Common = { valueMult = 1, color = Color3.fromRGB(180, 180, 180) },
	Uncommon = { valueMult = 2.2, color = Color3.fromRGB(96, 200, 96) },
	Rare = { valueMult = 5, color = Color3.fromRGB(70, 140, 255) },
	Epic = { valueMult = 12, color = Color3.fromRGB(170, 90, 240) },
	Legendary = { valueMult = 30, color = Color3.fromRGB(255, 170, 40) },
	Mythic = { valueMult = 100, color = Color3.fromRGB(255, 70, 90) },
}
FishConfig.RARITY_INFO = RarityInfo

local Fish: { [string]: Types.FishDef } = {
	-- ============ Starter Bay ============
	Sardine = {
		displayName = "Sardine",
		rarity = "Common",
		baseValue = 4,
		minWeight = 0.1,
		maxWeight = 0.4,
		zones = { "StarterBay" },
		description = "The bread and butter of every deckhand.",
	},
	Anchovy = {
		displayName = "Anchovy",
		rarity = "Common",
		baseValue = 5,
		minWeight = 0.1,
		maxWeight = 0.3,
		zones = { "StarterBay", "OpenOcean" },
		description = "Small, salty, and everywhere.",
	},
	Mackerel = {
		displayName = "Mackerel",
		rarity = "Common",
		baseValue = 7,
		minWeight = 0.5,
		maxWeight = 2,
		zones = { "StarterBay", "OpenOcean" },
		description = "Striped and speedy.",
	},
	BayBass = {
		displayName = "Bay Bass",
		rarity = "Uncommon",
		baseValue = 12,
		minWeight = 1,
		maxWeight = 4,
		zones = { "StarterBay" },
		description = "Puts up a decent fight for a bay fish.",
	},
	SilverMullet = {
		displayName = "Silver Mullet",
		rarity = "Uncommon",
		baseValue = 14,
		minWeight = 0.8,
		maxWeight = 3,
		zones = { "StarterBay" },
		description = "Its scales flash like coins underwater.",
	},
	GoldenKoi = {
		displayName = "Golden Koi",
		rarity = "Rare",
		baseValue = 25,
		minWeight = 1,
		maxWeight = 5,
		zones = { "StarterBay" },
		description = "Said to bring luck to new captains.",
	},

	-- ============ Open Ocean ============
	Tuna = {
		displayName = "Tuna",
		rarity = "Uncommon",
		baseValue = 18,
		minWeight = 10,
		maxWeight = 60,
		zones = { "OpenOcean" },
		description = "A torpedo with fins.",
	},
	Mahi = {
		displayName = "Mahi-Mahi",
		rarity = "Uncommon",
		baseValue = 20,
		minWeight = 5,
		maxWeight = 15,
		zones = { "OpenOcean" },
		description = "Brilliant gold and green.",
	},
	Swordfish = {
		displayName = "Swordfish",
		rarity = "Rare",
		baseValue = 32,
		minWeight = 30,
		maxWeight = 120,
		zones = { "OpenOcean", "StormZone" },
		description = "Handle with care.",
	},
	Marlin = {
		displayName = "Blue Marlin",
		rarity = "Epic",
		baseValue = 55,
		minWeight = 80,
		maxWeight = 400,
		zones = { "OpenOcean" },
		description = "The trophy every angler dreams about.",
	},
	MoonJelly = {
		displayName = "Moon Jelly",
		rarity = "Rare",
		baseValue = 28,
		minWeight = 0.5,
		maxWeight = 2,
		zones = { "OpenOcean", "DeepTrench" },
		description = "Glows faintly under moonlight.",
	},

	-- ============ Storm Zone ============
	StormCod = {
		displayName = "Storm Cod",
		rarity = "Uncommon",
		baseValue = 22,
		minWeight = 2,
		maxWeight = 8,
		zones = { "StormZone" },
		description = "Only surfaces when the waves turn violent.",
	},
	ThunderEel = {
		displayName = "Thunder Eel",
		rarity = "Rare",
		baseValue = 40,
		minWeight = 3,
		maxWeight = 12,
		zones = { "StormZone" },
		description = "Crackles with static. Do not lick.",
	},
	TempestRay = {
		displayName = "Tempest Ray",
		rarity = "Epic",
		baseValue = 70,
		minWeight = 20,
		maxWeight = 90,
		zones = { "StormZone" },
		description = "Rides the storm surge like a kite.",
	},
	Leviathan = {
		displayName = "Leviathan Pup",
		rarity = "Legendary",
		baseValue = 160,
		minWeight = 200,
		maxWeight = 800,
		zones = { "StormZone", "DeepTrench" },
		description = "If this is the pup, no one wants to meet the parent.",
	},

	-- ============ Deep Trench ============
	Anglerfish = {
		displayName = "Anglerfish",
		rarity = "Rare",
		baseValue = 38,
		minWeight = 5,
		maxWeight = 20,
		zones = { "DeepTrench" },
		description = "Brings its own lantern to the party.",
	},
	GulperEel = {
		displayName = "Gulper Eel",
		rarity = "Epic",
		baseValue = 65,
		minWeight = 8,
		maxWeight = 30,
		zones = { "DeepTrench" },
		description = "Mostly mouth.",
	},
	AbyssalSquid = {
		displayName = "Abyssal Squid",
		rarity = "Epic",
		baseValue = 75,
		minWeight = 40,
		maxWeight = 150,
		zones = { "DeepTrench" },
		description = "Ink black as the trench itself.",
	},
	GhostShark = {
		displayName = "Ghost Shark",
		rarity = "Legendary",
		baseValue = 180,
		minWeight = 60,
		maxWeight = 250,
		zones = { "DeepTrench" },
		description = "Seen only in the beam of a dying flashlight.",
	},
	Krakenling = {
		displayName = "Krakenling",
		rarity = "Mythic",
		baseValue = 500,
		minWeight = 300,
		maxWeight = 1200,
		zones = { "DeepTrench" },
		description = "Legends say catching one marks you forever.",
	},
	SunkenCrown = {
		displayName = "Sunken Crown Fish",
		rarity = "Mythic",
		baseValue = 650,
		minWeight = 2,
		maxWeight = 6,
		zones = { "DeepTrench" },
		description = "Wears the crown of a drowned king. Nobody asks how.",
	},
}
FishConfig.Fish = Fish

-- Build zone -&gt; rarity -&gt; {fishId} lookup once at require time.
local zoneRarityPools: { [string]: { [Types.Rarity]: { string } } } = {}
for fishId, def in FishConfig.Fish do
	for _, zoneId in def.zones do
		zoneRarityPools[zoneId] = zoneRarityPools[zoneId] or {}
		local pools = zoneRarityPools[zoneId]
		pools[def.rarity] = pools[def.rarity] or {}
		table.insert(pools[def.rarity] :: { string }, fishId)
	end
end
FishConfig.ZoneRarityPools = zoneRarityPools

function FishConfig.getFish(fishId: string): Types.FishDef?
	return FishConfig.Fish[fishId]
end

return FishConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source">--!strict
-- Global tuning knobs. Every "magic number" in the game should live here or in
-- a sibling config so balance passes never require touching system code.

local GameConfig = {
	-- Economy
	STARTING_DOUBLOONS = 100,
	STARTING_PEARLS = 0,

	-- Fishing
	CAST_COOLDOWN = 1.5, -- seconds between casts
	REEL_TIME_LIMIT = 12, -- client must report a reel result within this window
	REEL_MIN_TIME = 0.35, -- results faster than this are physically impossible -&gt; reject
	-- Accuracy from the reel minigame scales catch weight between these bounds.
	ACCURACY_WEIGHT_BONUS = 0.5, -- perfect reel = +50% weight roll bias

	-- Rod progression: each tier adds luck and widens the reel "sweet spot".
	ROD_TIERS = {
		{ name = "Driftwood Rod", cost = 0, luckBonus = 0, sweetSpotSize = 0.18 },
		{ name = "Oak Rod", cost = 250, luckBonus = 0.03, sweetSpotSize = 0.20 },
		{ name = "Fiberglass Rod", cost = 1_200, luckBonus = 0.06, sweetSpotSize = 0.23 },
		{ name = "Carbon Rod", cost = 5_000, luckBonus = 0.10, sweetSpotSize = 0.26 },
		{ name = "Trident Rod", cost = 20_000, luckBonus = 0.15, sweetSpotSize = 0.30 },
		{ name = "Abyssal Rod", cost = 75_000, luckBonus = 0.22, sweetSpotSize = 0.34 },
	},

	-- Market / selling (see MarketService for the demand simulation)
	MARKET = {
		-- Demand drops by this fraction of a full recovery for every fish of a
		-- rarity sold, and recovers back to 1.0 over RECOVERY_SECONDS.
		DEMAND_HIT_PER_SALE = 0.02,
		MIN_DEMAND = 0.5,
		MAX_DEMAND = 1.5, -- scarcity bonus when nobody has sold a rarity lately
		RECOVERY_SECONDS = 600,
		-- Small random walk applied each tick so prices feel alive.
		DRIFT_INTERVAL = 30,
		DRIFT_MAGNITUDE = 0.03,
	},

	-- Interaction distances (server-validated; the client UI just mirrors them)
	DOCK_INTERACT_DISTANCE = 24,

	-- Fixed world landmarks, shared by server services (validation, building)
	-- and the client (minimap). Keep in sync with ZoneConfig.Layout.
	WORLD = {
		DOCKMASTER_POSITION = Vector3.new(-40, 5, -60),
		MARKET_POSITION = Vector3.new(40, 5, -60),
		BOAT_SPAWN = Vector3.new(0, 3, -30),
		-- Treasure Diving wreck site (seafloor of Starter Bay).
		DIVE_SITE = Vector3.new(-100, -25, 90),
		-- Storm Navigation course start (open water south of the bay).
		STORM_COURSE_START = Vector3.new(120, 2, -160),
	},

	-- Battle pass XP sources
	XP_PER_CATCH = { Common = 5, Uncommon = 10, Rare = 25, Epic = 60, Legendary = 150, Mythic = 400 },
	XP_PER_MINIGAME_WIN = 35,

	-- Passive income once the player owns the cruise liner (tier 10):
	-- NPC passengers pay ticket revenue on a timer. Tune freely.
	CRUISE_PASSIVE = {
		REQUIRED_TIER = 10,
		INTERVAL_SECONDS = 60,
		DOUBLOONS_PER_TICK = 250,
	},
}

return GameConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">MiniGameConfig</string><ProtectedString name="Source">--!strict
-- Mini-game registry. Each entry maps to a ModuleScript in
-- ServerScriptService/Services/MiniGames/&lt;id&gt;.luau implementing the
-- MiniGameManager interface (see that file for the contract).

local MiniGameConfig = {}

MiniGameConfig.Games = {
	CrabRacing = {
		id = "CrabRacing",
		displayName = "Crab Racing",
		description = "Bet on the fastest crustacean in the bay.",
		stationPosition = Vector3.new(80, 5, 120),
		enabled = true,
		config = {
			crabCount = 4,
			trackLength = 100, -- abstract units, replicated as 0..1 progress
			bettingSeconds = 20,
			raceSeconds = 15,
			minBet = 10,
			maxBet = 5_000,
			-- Payout = bet * odds of the chosen crab (house takes nothing; the
			-- spread comes from odds rounding). Odds derive from hidden speed.
		},
	},
	TreasureDiving = {
		id = "TreasureDiving",
		displayName = "Treasure Diving",
		description = "Dive the wreck and grab treasure before your air runs out.",
		stationPosition = Vector3.new(-100, 5, 90),
		enabled = true,
		config = {
			divingSeconds = 60,
			treasureCount = 12,
			payoutPerTreasure = 15,
			-- Radius around the wreck site treasures scatter within.
			scatterRadius = 30,
			-- Server-side sanity distance for a Collect (prompt range + lag slack).
			collectRange = 14,
		},
	},
	StormNavigation = {
		id = "StormNavigation",
		displayName = "Storm Navigation",
		description = "Steer a skiff through the squall's hazards for a bonus payout.",
		stationPosition = Vector3.new(120, 5, -90),
		enabled = true,
		config = {
			courseSeconds = 75,
			checkpointCount = 8,
			hazardsPerGap = 2,
			basePayout = 200,
			hitPenalty = 0.15, -- payout multiplier lost per hazard hit
			consolationPerCheckpoint = 10, -- paid if the timer expires mid-course
			skiffSpeed = 34,
		},
	},
}

return MiniGameConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">MonetizationConfig</string><ProtectedString name="Source">--!strict
-- Cosmetic-only monetization. Pearls (premium currency) buy skins and pets;
-- nothing here raises fishing income beyond the tiny capped pet bonuses.
-- IMPORTANT: replace every `productId = 0` / `gamePassId = 0` with real ids
-- created in the Creator Dashboard before publishing.

local Types = require(script.Parent.Parent.Types)

local MonetizationConfig = {}

-- Developer Products: Pearl bundles (consumable purchases).
MonetizationConfig.PearlProducts = {
	{ productId = 0, pearls = 100, name = "Handful of Pearls" }, -- TODO real id
	{ productId = 0, pearls = 550, name = "Pouch of Pearls" }, -- TODO real id
	{ productId = 0, pearls = 1200, name = "Chest of Pearls" }, -- TODO real id
}

-- Game Pass: premium battle pass track.
MonetizationConfig.PremiumBattlePassGamePassId = 0 -- TODO real id

-- Boat skins (Pearls). `seasonal` skins should only be purchasable while the
-- matching event flag is on (see BattlePassConfig.SEASON).
MonetizationConfig.BoatSkins = {
	Midnight = {
		id = "Midnight",
		displayName = "Midnight Hull",
		pearlCost = 250,
		seasonal = false,
		color = Color3.fromRGB(15, 15, 25),
	},
	Candy = {
		id = "Candy",
		displayName = "Candy Stripe",
		pearlCost = 250,
		seasonal = false,
		color = Color3.fromRGB(255, 105, 180),
	},
	Gilded = {
		id = "Gilded",
		displayName = "Gilded Hull",
		pearlCost = 800,
		seasonal = false,
		color = Color3.fromRGB(212, 175, 55),
	},
	KrakenWrap = {
		id = "KrakenWrap",
		displayName = "Kraken Wrap",
		pearlCost = 1200,
		seasonal = true,
		color = Color3.fromRGB(60, 20, 90),
	},
}

-- Rod skins (Pearls). Purely visual.
MonetizationConfig.RodSkins = {
	Coral = { id = "Coral", displayName = "Coral Rod", pearlCost = 150, color = Color3.fromRGB(255, 127, 100) },
	Neon = { id = "Neon", displayName = "Neon Rod", pearlCost = 300, color = Color3.fromRGB(0, 255, 170) },
	Royal = { id = "Royal", displayName = "Royal Rod", pearlCost = 600, color = Color3.fromRGB(120, 60, 220) },
}

-- Pets/crew follow the player. Bonuses are intentionally tiny and hard-capped
-- below so no future config edit can sneak in pay-to-win numbers.
MonetizationConfig.MAX_PET_LUCK = 0.05
MonetizationConfig.MAX_PET_SELL_BONUS = 0.05

local Pets: { [string]: Types.PetDef } = {
	Seagull = {
		id = "Seagull",
		displayName = "First Mate Seagull",
		premiumCost = 200,
		luckBonus = 0.02,
		sellBonus = 0,
		description = "Squawks encouragingly. +2% luck.",
	},
	Crab = {
		id = "Crab",
		displayName = "Deckhand Crab",
		premiumCost = 200,
		luckBonus = 0,
		sellBonus = 0.02,
		description = "Haggles with fishmongers. +2% sell price.",
	},
	Parrot = {
		id = "Parrot",
		displayName = "Quartermaster Parrot",
		premiumCost = 500,
		luckBonus = 0.03,
		sellBonus = 0.03,
		description = "A well-rounded shoulder companion. +3%/+3%.",
	},
}
MonetizationConfig.Pets = Pets

return MonetizationConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">ZoneConfig</string><ProtectedString name="Source">--!strict
-- Fishing zones. Each zone is a named region in Workspace ("Zones/&lt;id&gt;") whose
-- bounds gate both travel (boat tier) and the fish drop table.
-- Positions/sizes here drive the placeholder region parts the server spawns;
-- sculpt the real terrain in Studio to roughly match.

local Types = require(script.Parent.Parent.Types)

local ZoneConfig = {}

local Zones: { [string]: Types.ZoneDef } = {
	StarterBay = {
		id = "StarterBay",
		displayName = "Starter Bay",
		requiredBoatTier = 1,
		rarityWeights = { Common = 70, Uncommon = 25, Rare = 5, Epic = 0, Legendary = 0, Mythic = 0 },
		biteTimeRange = { min = 2, max = 5 },
		payoutMultiplier = 1,
		description = "Calm, shallow water. Learn the ropes here.",
	},
	OpenOcean = {
		id = "OpenOcean",
		displayName = "Open Ocean",
		requiredBoatTier = 3,
		rarityWeights = { Common = 40, Uncommon = 38, Rare = 17, Epic = 5, Legendary = 0, Mythic = 0 },
		biteTimeRange = { min = 3, max = 7 },
		payoutMultiplier = 1.25,
		description = "Big water, bigger fish.",
	},
	StormZone = {
		id = "StormZone",
		displayName = "Storm Zone",
		requiredBoatTier = 6,
		rarityWeights = { Common = 15, Uncommon = 35, Rare = 30, Epic = 15, Legendary = 5, Mythic = 0 },
		biteTimeRange = { min = 4, max = 9 },
		payoutMultiplier = 1.75,
		description = "High risk, high reward. Bring a reinforced hull.",
	},
	DeepTrench = {
		id = "DeepTrench",
		displayName = "Deep Trench",
		requiredBoatTier = 8,
		rarityWeights = { Common = 5, Uncommon = 20, Rare = 35, Epic = 25, Legendary = 12, Mythic = 3 },
		biteTimeRange = { min = 5, max = 12 },
		payoutMultiplier = 2.5,
		description = "The abyss stares back — and it's full of Doubloons.",
	},
}
ZoneConfig.Zones = Zones

-- Placeholder world layout (studs, XZ plane). Studio terrain should follow this
-- rough map so zone gating matches the geography.
local Layout: { [string]: { center: Vector3, size: Vector3 } } = {
	StarterBay = { center = Vector3.new(0, 0, 0), size = Vector3.new(512, 100, 512) },
	OpenOcean = { center = Vector3.new(1024, 0, 0), size = Vector3.new(1024, 200, 1024) },
	StormZone = { center = Vector3.new(1024, 0, 1280), size = Vector3.new(1024, 200, 1024) },
	DeepTrench = { center = Vector3.new(2560, 0, 640), size = Vector3.new(1024, 400, 1024) },
}
ZoneConfig.Layout = Layout

function ZoneConfig.getZone(zoneId: string): Types.ZoneDef?
	return ZoneConfig.Zones[zoneId]
end

-- Returns the zone id containing a world position, or nil if outside all zones.
function ZoneConfig.zoneAtPosition(position: Vector3): string?
	for zoneId, bounds in ZoneConfig.Layout do
		local half = bounds.size / 2
		local offset = position - bounds.center
		if math.abs(offset.X) &lt;= half.X and math.abs(offset.Z) &lt;= half.Z then
			return zoneId
		end
	end
	return nil
end

return ZoneConfig
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX12"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Format</string><ProtectedString name="Source">--!strict
-- Small display-formatting helpers shared by all UI.

local Format = {}

-- 1234567 -&gt; "1.23M", 4200 -&gt; "4.2K", 999 -&gt; "999"
function Format.abbreviate(amount: number): string
	local absAmount = math.abs(amount)
	local sign = if amount &lt; 0 then "-" else ""
	if absAmount &gt;= 1_000_000_000 then
		return string.format("%s%.2fB", sign, absAmount / 1_000_000_000)
	elseif absAmount &gt;= 1_000_000 then
		return string.format("%s%.2fM", sign, absAmount / 1_000_000)
	elseif absAmount &gt;= 10_000 then
		return string.format("%s%.1fK", sign, absAmount / 1_000)
	elseif absAmount &gt;= 1_000 then
		return string.format("%s%.2fK", sign, absAmount / 1_000)
	end
	return sign .. tostring(math.floor(absAmount))
end

-- 1234567 -&gt; "1,234,567" for precise contexts (shop prices)
function Format.comma(amount: number): string
	local formatted = tostring(math.floor(amount))
	while true do
		local replaced
		formatted, replaced = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return formatted
end

function Format.weight(kg: number): string
	if kg &gt;= 100 then
		return string.format("%d kg", math.floor(kg))
	end
	return string.format("%.1f kg", kg)
end

function Format.clock(seconds: number): string
	local mins = math.floor(seconds / 60)
	local secs = math.floor(seconds % 60)
	return string.format("%d:%02d", mins, secs)
end

return Format
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">WeightedRandom</string><ProtectedString name="Source">--!strict
-- Weighted random selection with an optional "luck" skew.
-- Luck shifts probability mass from early entries toward later entries, so
-- weight tables MUST be ordered common -&gt; rare when luck is used.

local WeightedRandom = {}

local rng = Random.new()

export type WeightedEntry&lt;T&gt; = { value: T, weight: number }

-- Pick from an ordered list of {value, weight}. luck (0..1) multiplies each
-- entry's weight by (1 + luck * indexBias) where later entries get more bias.
function WeightedRandom.pick&lt;T&gt;(entries: { WeightedEntry&lt;T&gt; }, luck: number?): T?
	local appliedLuck = math.clamp(luck or 0, 0, 1)
	local total = 0
	local weights = table.create(#entries)
	for index, entry in entries do
		-- indexBias: 0 for the first entry, rising to 3 for the last, so max
		-- luck (1.0) quadruples the relative weight of the rarest entry.
		local indexBias = if #entries &gt; 1 then 3 * (index - 1) / (#entries - 1) else 0
		local weight = entry.weight * (1 + appliedLuck * indexBias)
		weights[index] = weight
		total += weight
	end
	if total &lt;= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for index, entry in entries do
		roll -= weights[index]
		if roll &lt;= 0 then
			return entry.value
		end
	end
	return entries[#entries].value
end

function WeightedRandom.range(min: number, max: number): number
	return min + rng:NextNumber() * (max - min)
end

-- Biased range roll: bias 0 = uniform, bias 1 = strongly favors max.
-- Used to reward accurate reeling with heavier fish.
function WeightedRandom.biasedRange(min: number, max: number, bias: number): number
	local sample = rng:NextNumber()
	local shaped = sample ^ (1 / (1 + math.clamp(bias, 0, 1)))
	return min + shaped * (max - min)
end

return WeightedRandom
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Remotes</string><ProtectedString name="Source">--!strict
-- Single source of truth for every remote. The server calls Remotes.init()
-- once at startup to create the instances; the client waits for them.
-- Never create remotes anywhere else — auditing the client/server surface
-- should only require reading this file.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

local EVENTS = {
	-- Fishing (client -&gt; server intents, server -&gt; client state)
	"CastRequest", -- C-&gt;S ()
	"CancelCast", -- C-&gt;S ()
	"BiteAlert", -- S-&gt;C (reelParams: {sweetSpotSize, timeLimit})
	"ReelResult", -- C-&gt;S (accuracy: number 0..1)
	"CatchResult", -- S-&gt;C (fish: CaughtFish?, escaped: boolean)

	-- Economy / progression pushes
	"DataChanged", -- S-&gt;C (partial PlayerData snapshot for HUD/UI)
	"Notify", -- S-&gt;C (message: string, kind: "info"|"success"|"error")

	-- Mini-games
	"MiniGameState", -- S-&gt;C broadcast (gameId, state table)
	"MiniGameAction", -- C-&gt;S (gameId, action, payload)

	-- Boat
	"BoatSpawned", -- S-&gt;C (boatModel reference via Workspace name)
}

local FUNCTIONS = {
	"GetData", -- C-&gt;S: full sanitized PlayerData snapshot
	"SellAllFish", -- C-&gt;S: -&gt; {ok, earned?, message?}
	"UpgradeBoat", -- C-&gt;S: -&gt; {ok, newTier?, message?}
	"UpgradeRod", -- C-&gt;S: -&gt; {ok, newTier?, message?}
	"BuyBait", -- C-&gt;S (baitId, amount) -&gt; {ok, message?}
	"EquipBait", -- C-&gt;S (baitId?) -&gt; {ok}
	"BuyCosmetic", -- C-&gt;S (category, itemId) -&gt; {ok, message?}
	"EquipCosmetic", -- C-&gt;S (category, itemId?) -&gt; {ok}
	"ClaimBattlePassTier", -- C-&gt;S (tierIndex, premium: boolean) -&gt; {ok, message?}
	"GetMarketPrices", -- C-&gt;S: -&gt; {[rarity]: demandMultiplier}
}

local Remotes = {}

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) :: Folder?
		if not folder then
			local newFolder = Instance.new("Folder")
			newFolder.Name = FOLDER_NAME
			newFolder.Parent = ReplicatedStorage
			folder = newFolder
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

-- Server-only: create all remotes up front so the client never races them.
function Remotes.init()
	assert(RunService:IsServer(), "Remotes.init must run on the server")
	local folder = getFolder()
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

function Remotes.getEvent(name: string): RemoteEvent
	local folder = getFolder()
	if RunService:IsServer() then
		return folder:FindFirstChild(name) :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.getFunction(name: string): RemoteFunction
	local folder = getFolder()
	if RunService:IsServer() then
		return folder:FindFirstChild(name) :: RemoteFunction
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Shared type definitions used by both the server and the client.
-- Keep every cross-boundary data shape here so remotes stay honest.

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic"

export type FishDef = {
	displayName: string,
	rarity: Rarity,
	baseValue: number, -- Doubloons before rarity/market multipliers
	minWeight: number, -- kg
	maxWeight: number, -- kg
	zones: { string }, -- ZoneConfig ids this fish can appear in
	description: string,
}

export type CaughtFish = {
	fishId: string,
	weight: number, -- rolled kg, affects sell value
	caughtAt: number, -- os.time()
	zoneId: string,
}

export type DexEntry = {
	caught: number,
	bestWeight: number,
	firstCaughtAt: number,
}

export type BoatTierDef = {
	tier: number,
	displayName: string,
	cost: number, -- Doubloons to upgrade INTO this tier
	speed: number, -- studs/sec used by the VehicleSeat
	storage: number, -- max fish held before selling
	rodSlots: number,
	description: string,
	-- Purely visual hints for the Studio pass (hull size/colors); logic never reads these.
	appearance: { size: Vector3, color: Color3 },
}

export type ZoneDef = {
	id: string,
	displayName: string,
	requiredBoatTier: number,
	-- Weighted rarity table; FishingService rolls rarity first, then a fish of
	-- that rarity that lists this zone.
	rarityWeights: { [Rarity]: number },
	biteTimeRange: { min: number, max: number }, -- seconds until a bite
	payoutMultiplier: number, -- zone-wide sell value bonus (risk/reward)
	description: string,
}

export type BaitDef = {
	id: string,
	displayName: string,
	cost: number,
	-- Additive luck shifts rarity weights toward the rare end (see FishingService).
	luckBonus: number,
	biteSpeedMultiplier: number, -- &lt;1 means faster bites
	description: string,
}

export type PetDef = {
	id: string,
	displayName: string,
	premiumCost: number, -- Pearls
	-- Deliberately tiny bonuses: cosmetics-first, never pay-to-win.
	luckBonus: number, -- capped at 0.05 by MonetizationConfig.MAX_PET_LUCK
	sellBonus: number, -- capped at 0.05
	description: string,
}

export type BattlePassReward = {
	kind: "Doubloons" | "Pearls" | "Bait" | "BoatSkin" | "RodSkin" | "Pet",
	amount: number?,
	itemId: string?,
}

export type BattlePassTier = {
	xpRequired: number, -- cumulative XP to reach this tier
	freeReward: BattlePassReward?,
	premiumReward: BattlePassReward?,
}

-- The full persisted player profile. Bump DataService.SCHEMA_VERSION and add a
-- migration step whenever this shape changes.
export type PlayerData = {
	schemaVersion: number,
	doubloons: number,
	pearls: number,
	boatTier: number,
	rodTier: number,
	equippedBait: string?, -- BaitDef id
	baitInventory: { [string]: number },
	fishInventory: { CaughtFish },
	fishDex: { [string]: DexEntry },
	cosmetics: {
		boatSkins: { [string]: boolean },
		rodSkins: { [string]: boolean },
		pets: { [string]: boolean },
		equipped: { boatSkin: string?, rodSkin: string?, pet: string? },
	},
	miniGameHighScores: { [string]: number },
	battlePass: {
		season: number,
		xp: number,
		ownsPremium: boolean,
		claimedFree: { [string]: boolean }, -- keyed by tostring(tierIndex)
		claimedPremium: { [string]: boolean },
	},
	stats: {
		totalCatches: number,
		totalEarned: number,
		joinCount: number,
	},
	-- Receipt PurchaseIds already granted; makes ProcessReceipt idempotent.
	redeemedReceipts: { [string]: boolean },
}

return nil
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX53"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX33"><Properties><string name="Name">Server</string></Properties><Item class="Folder" referent="RBX31"><Properties><string name="Name">Services</string></Properties><Item class="Folder" referent="RBX19"><Properties><string name="Name">MiniGames</string></Properties><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">CrabRacing</string><ProtectedString name="Source">--!strict
-- Crab Racing — fully implemented reference mini-game.
--
-- Loop: Betting (20s, players bet on a crab) -&gt; Racing (~15s simulated with
-- hidden per-crab speeds, progress broadcast every tick) -&gt; Payout -&gt; repeat.
-- Odds are derived from the hidden speeds and shown during betting, so smart
-- players can bet value. All money movement is server-side via the manager
-- context; the client only ever sends {action = "Bet", crabIndex, amount}.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MiniGameConfig = require(Shared.Config.MiniGameConfig)

local ModelFactory = require(script.Parent.Parent.ModelFactory)

local CrabRacing = {}

local CRAB_NAMES = { "Sir Pinchalot", "Clawdia", "Shellby", "Bubbles", "Snippy", "General Krust" }
local CRAB_COLORS = {
	Color3.fromRGB(220, 80, 60),
	Color3.fromRGB(80, 140, 220),
	Color3.fromRGB(110, 200, 90),
	Color3.fromRGB(230, 180, 60),
	Color3.fromRGB(180, 90, 210),
	Color3.fromRGB(240, 240, 245),
}

-- World-space track next to the station platform; crabs are physical models
-- pivoted along their lanes from race progress, so races are watchable live.
local TRACK_START_Z = 26 -- offsets from the station position
local TRACK_LENGTH = 36
local LANE_SPACING = 6

type Bet = { crabIndex: number, amount: number }

local context: any = nil
local config: any = nil

local phase: "Betting" | "Racing" | "Payout" = "Betting"
local phaseEndsAt = 0
local crabs: { { name: string, speed: number, progress: number, odds: number } } = {}
local bets: { [Player]: Bet } = {}
local crabModels: { Model } = {}
local trackOrigin: Vector3 = Vector3.zero

local function buildTrack()
	local station = MiniGameConfig.Games.CrabRacing.stationPosition
	trackOrigin = Vector3.new(station.X, 2.6, station.Z + TRACK_START_Z)

	local platform = Instance.new("Part")
	platform.Name = "CrabTrack"
	platform.Size = Vector3.new(config.crabCount * LANE_SPACING + 8, 1, TRACK_LENGTH + 12)
	platform.Position = Vector3.new(station.X, 2, station.Z + TRACK_START_Z + TRACK_LENGTH / 2)
	platform.Anchored = true
	platform.Color = Color3.fromRGB(200, 180, 140)
	platform.Material = Enum.Material.Sand
	platform.Parent = workspace

	for _, lineInfo in
		{ { z = 0, color = Color3.fromRGB(240, 240, 245) }, { z = TRACK_LENGTH, color = Color3.fromRGB(240, 195, 80) } }
	do
		local line = Instance.new("Part")
		line.Name = "TrackLine"
		line.Size = Vector3.new(platform.Size.X, 0.2, 1)
		line.Position = Vector3.new(station.X, 2.6, trackOrigin.Z + lineInfo.z)
		line.Anchored = true
		line.CanCollide = false
		line.Color = lineInfo.color
		line.Material = Enum.Material.Neon
		line.Parent = workspace
	end
end

local function laneX(index: number): number
	local station = MiniGameConfig.Games.CrabRacing.stationPosition
	return station.X + (index - (config.crabCount + 1) / 2) * LANE_SPACING
end

local function updateCrabModels()
	for index, crab in crabs do
		local model = crabModels[index]
		if model then
			model:PivotTo(CFrame.new(laneX(index), trackOrigin.Y + 0.8, trackOrigin.Z + crab.progress * TRACK_LENGTH))
		end
	end
end

local function respawnCrabModels()
	for _, model in crabModels do
		model:Destroy()
	end
	crabModels = {}
	for index = 1, #crabs do
		local model = ModelFactory.buildCrab(CRAB_COLORS[(index - 1) % #CRAB_COLORS + 1])
		model.Parent = workspace
		crabModels[index] = model
	end
	updateCrabModels()
end

local function broadcastState(extra: any?)
	local crabView = {}
	for index, crab in crabs do
		crabView[index] = {
			name = crab.name,
			progress = crab.progress,
			odds = crab.odds,
		}
	end
	local state = {
		phase = phase,
		secondsLeft = math.max(0, math.floor(phaseEndsAt - os.clock())),
		crabs = crabView,
	}
	if extra then
		for key, value in extra do
			state[key] = value
		end
	end
	context.broadcast(state)
end

local function setupRace()
	crabs = {}
	local usedNames = {}
	for _ = 1, config.crabCount do
		local name
		repeat
			name = CRAB_NAMES[math.random(1, #CRAB_NAMES)]
		until not usedNames[name]
		usedNames[name] = true
		table.insert(crabs, {
			name = name,
			-- Hidden speed. Race sim adds noise so the favorite doesn't always win.
			speed = 0.8 + math.random() * 0.4,
			progress = 0,
			odds = 0,
		})
	end
	-- Fair-ish decimal odds from inverse speed share, min 1.1x.
	local totalSpeed = 0
	for _, crab in crabs do
		totalSpeed += crab.speed
	end
	for _, crab in crabs do
		crab.odds = math.max(1.1, math.floor((totalSpeed / crab.speed) * 10) / 10)
	end
	respawnCrabModels()
end

local function runRace()
	phase = "Racing"
	phaseEndsAt = os.clock() + config.raceSeconds
	local winner: number? = nil
	while winner == nil do
		task.wait(0.25)
		for index, crab in crabs do
			-- Per-tick noise: speed dominates but any crab can surge.
			local step = (crab.speed * 0.6 + math.random() * 0.8) / (config.raceSeconds * 4)
			crab.progress = math.min(1, crab.progress + step)
			if crab.progress &gt;= 1 then
				winner = winner or index -- first to finish this tick wins
			end
		end
		updateCrabModels()
		broadcastState()
	end
	return winner :: number
end

local function payout(winnerIndex: number)
	phase = "Payout"
	phaseEndsAt = os.clock() + 6
	local winnerCrab = crabs[winnerIndex]
	for player, bet in bets do
		if player.Parent ~= Players then
			continue
		end
		if bet.crabIndex == winnerIndex then
			local winnings = math.floor(bet.amount * winnerCrab.odds)
			context.awardDoubloons(player, winnings)
			context.grantWinXP(player)
			context.reportScore(player, winnings)
			context.sendTo(player, {
				phase = "Payout",
				personal = { won = true, amount = winnings, crabName = winnerCrab.name },
				crabs = {},
			})
		else
			context.sendTo(player, {
				phase = "Payout",
				personal = { won = false, amount = bet.amount, crabName = winnerCrab.name },
				crabs = {},
			})
		end
	end
	broadcastState({ winner = winnerIndex, winnerName = winnerCrab.name })
	bets = {}
	task.wait(6)
end

local function gameLoop()
	while true do
		setupRace()
		phase = "Betting"
		phaseEndsAt = os.clock() + config.bettingSeconds
		broadcastState()
		-- Re-broadcast the countdown each second so late joiners sync.
		for _ = 1, config.bettingSeconds do
			task.wait(1)
			broadcastState()
		end
		local winnerIndex = runRace()
		payout(winnerIndex)
	end
end

--------------------------------------------------------------------------------
-- MiniGameManager contract
--------------------------------------------------------------------------------

function CrabRacing.init(managerContext: any)
	context = managerContext
	config = managerContext.config
	buildTrack()
	Players.PlayerRemoving:Connect(function(player)
		bets[player] = nil -- forfeit: bet was already escrowed on placement
	end)
	task.spawn(gameLoop)
end

function CrabRacing.handleAction(player: Player, action: string, payload: any)
	if action ~= "Bet" then
		return
	end
	if phase ~= "Betting" then
		context.sendTo(player, { phase = phase, error = "Betting is closed." })
		return
	end
	if bets[player] then
		context.sendTo(player, { phase = phase, error = "You already placed a bet this race." })
		return
	end
	-- Strict payload validation — this is a money path.
	if typeof(payload) ~= "table" then
		return
	end
	local crabIndex = payload.crabIndex
	local amount = payload.amount
	if typeof(crabIndex) ~= "number" or crabs[crabIndex] == nil then
		return
	end
	if typeof(amount) ~= "number" or amount ~= math.floor(amount) then
		return
	end
	if amount &lt; config.minBet or amount &gt; config.maxBet then
		context.sendTo(player, { phase = phase, error = `Bets are {config.minBet}-{config.maxBet} Doubloons.` })
		return
	end
	-- Escrow the stake immediately; chargeDoubloons fails on insufficient funds.
	if not context.chargeDoubloons(player, amount) then
		context.sendTo(player, { phase = phase, error = "Not enough Doubloons." })
		return
	end
	bets[player] = { crabIndex = crabIndex, amount = amount }
	context.sendTo(player, {
		phase = phase,
		betPlaced = { crabIndex = crabIndex, amount = amount, crabName = crabs[crabIndex].name },
	})
end

return CrabRacing
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">StormNavigation</string><ProtectedString name="Source">--!strict
-- Storm Navigation — solo timed slalom in a loaner skiff.
--
-- Flow: "Start" at the station -&gt; server builds a zigzag course of neon
-- checkpoint gates with rock hazards between them, spawns a skiff (shared
-- drive loop via BoatService.registerExternalBoat), and seats the player.
-- Checkpoints must be hit IN ORDER (server-side Touched detection on the
-- skiff's parts only); each hazard hit cuts the payout. Finish all gates
-- before the clock for the full payout; timer expiry pays consolation per
-- gate. High score = time remaining in ms on a clean finish-friendly scale.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local BoatService = require(script.Parent.Parent.BoatService)
local ModelFactory = require(script.Parent.Parent.ModelFactory)

local StormNavigation = {}

local context: any = nil
local config: any = nil

type Session = {
	startedAt: number,
	endsAt: number,
	nextCheckpoint: number,
	hits: number,
	lastHitAt: number,
	folder: Folder,
	skiff: Model,
	returnCFrame: CFrame,
	finished: boolean,
}

local sessions: { [Player]: Session } = {}

local SKIFF_DEF = {
	tier = 3,
	displayName = "Storm Skiff",
	speed = 0, -- filled from config at init
	appearance = { size = Vector3.new(5, 2, 11), color = Color3.fromRGB(70, 80, 100) },
}

local function sendState(player: Player, session: Session)
	context.sendTo(player, {
		phase = "Active",
		timeLeft = math.max(0, math.floor(session.endsAt - os.clock())),
		checkpoints = session.nextCheckpoint - 1,
		totalCheckpoints = config.checkpointCount,
		hits = session.hits,
	})
end

local function isSessionHull(session: Session, hit: BasePart): boolean
	return hit:IsDescendantOf(session.skiff)
end

local function endSession(player: Player, session: Session, finishedCourse: boolean)
	if session.finished then
		return
	end
	session.finished = true
	sessions[player] = nil
	BoatService.unregisterExternalBoat(session.skiff)

	local payout: number
	local elapsed = os.clock() - session.startedAt
	if finishedCourse then
		local multiplier = math.max(1 - session.hits * config.hitPenalty, 0.1)
		payout = math.floor(config.basePayout * multiplier)
		context.grantWinXP(player)
		-- Higher = better: remaining milliseconds, only on a real finish.
		context.reportScore(player, math.floor((config.courseSeconds - elapsed) * 1000))
	else
		payout = (session.nextCheckpoint - 1) * config.consolationPerCheckpoint
	end
	if payout &gt; 0 then
		context.awardDoubloons(player, payout)
	end

	local character = player.Character
	if character and character.Parent then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false
		end
		task.wait(0.1) -- let the seat weld release before teleporting
		character:PivotTo(session.returnCFrame)
	end
	session.folder:Destroy()
	session.skiff:Destroy()

	context.sendTo(player, {
		phase = "Done",
		finished = finishedCourse,
		hits = session.hits,
		payout = payout,
		timeTaken = math.floor(elapsed),
	})
end

-- Zigzag course heading south (+X wiggle, -Z advance) from the start buoy.
local function checkpointPosition(start: Vector3, index: number): Vector3
	local advance = 55
	local wiggle = 35
	return start + Vector3.new(math.sin(index * 1.9) * wiggle, 0, -index * advance)
end

local function buildCourse(player: Player, session: Session, start: Vector3)
	for index = 1, config.checkpointCount do
		local position = checkpointPosition(start, index)
		local isFinish = index == config.checkpointCount

		local gate = Instance.new("Part")
		gate.Name = `Checkpoint{index}`
		gate.Size = Vector3.new(16, 12, 2)
		gate.CFrame = CFrame.new(Vector3.new(position.X, 4, position.Z))
		gate.Anchored = true
		gate.CanCollide = false
		gate.Transparency = 0.5
		gate.Color = if isFinish then Color3.fromRGB(240, 195, 80) else Color3.fromRGB(70, 210, 110)
		gate.Material = Enum.Material.Neon
		gate.Touched:Connect(function(hit)
			if session.finished or not isSessionHull(session, hit) then
				return
			end
			if index ~= session.nextCheckpoint then
				return -- out of order: ignore (no skipping gates)
			end
			session.nextCheckpoint += 1
			gate.Transparency = 0.9
			if session.nextCheckpoint &gt; config.checkpointCount then
				endSession(player, session, true)
			else
				sendState(player, session)
			end
		end)
		gate.Parent = session.folder

		-- Hazard rocks scattered in the gap before this gate.
		if index &gt; 1 then
			local previous = checkpointPosition(start, index - 1)
			for hazardIndex = 1, config.hazardsPerGap do
				local t = hazardIndex / (config.hazardsPerGap + 1)
				local mid = previous:Lerp(position, t)
				local rock = Instance.new("Part")
				rock.Name = "Hazard"
				rock.Shape = Enum.PartType.Ball
				rock.Size = Vector3.new(6, 6, 6)
				rock.Position = Vector3.new(mid.X + (math.random() - 0.5) * 24, 0.5, mid.Z)
				rock.Anchored = true
				rock.CanCollide = true
				rock.Color = Color3.fromRGB(80, 80, 90)
				rock.Material = Enum.Material.Slate
				rock.Touched:Connect(function(hit)
					if session.finished or not isSessionHull(session, hit) then
						return
					end
					-- 1s debounce so one scrape isn't five hits.
					if os.clock() - session.lastHitAt &lt; 1 then
						return
					end
					session.lastHitAt = os.clock()
					session.hits += 1
					sendState(player, session)
				end)
				rock.Parent = session.folder
			end
		end
	end
end

local function startRun(player: Player)
	if sessions[player] then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not root or not humanoid then
		return
	end

	local start: Vector3 = GameConfig.WORLD.STORM_COURSE_START

	local folder = Instance.new("Folder")
	folder.Name = `StormRun_{player.UserId}`
	folder.Parent = workspace

	local skiff = ModelFactory.buildBoat(SKIFF_DEF)
	skiff.Name = `StormSkiff_{player.UserId}`
	-- Face the course (-Z).
	skiff:PivotTo(CFrame.new(start))
	skiff.Parent = workspace
	BoatService.registerExternalBoat(skiff)

	local session: Session = {
		startedAt = os.clock(),
		endsAt = os.clock() + config.courseSeconds,
		nextCheckpoint = 1,
		hits = 0,
		lastHitAt = 0,
		folder = folder,
		skiff = skiff,
		returnCFrame = root.CFrame,
		finished = false,
	}
	sessions[player] = session
	buildCourse(player, session, start)

	-- Seat the player in the skiff.
	local seat = skiff:FindFirstChild("DriverSeat") :: VehicleSeat
	character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
	task.wait(0.1)
	seat:Sit(humanoid)
	sendState(player, session)

	-- Clock + 1s ticker.
	task.spawn(function()
		while not session.finished do
			task.wait(1)
			if session.finished then
				return
			end
			if os.clock() &gt;= session.endsAt or not player.Parent then
				endSession(player, session, false)
				return
			end
			sendState(player, session)
		end
	end)
end

--------------------------------------------------------------------------------
-- MiniGameManager contract
--------------------------------------------------------------------------------

function StormNavigation.init(managerContext: any)
	context = managerContext
	config = managerContext.config
	SKIFF_DEF.speed = config.skiffSpeed
	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			session.finished = true
			sessions[player] = nil
			BoatService.unregisterExternalBoat(session.skiff)
			session.folder:Destroy()
			session.skiff:Destroy()
		end
	end)
end

function StormNavigation.handleAction(player: Player, action: string, _payload: any)
	if action == "Start" then
		startRun(player)
	elseif action == "Abort" then
		local session = sessions[player]
		if session then
			endSession(player, session, false)
		end
	end
end

return StormNavigation
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">TreasureDiving</string><ProtectedString name="Source">--!strict
-- Treasure Diving — solo timed dive at the sunken wreck.
--
-- Flow: "Start" at the station -&gt; server teleports the diver into the water
-- above the wreck, scatters glowing treasure chests on the seafloor, and runs
-- an air timer. Treasures are collected via their ProximityPrompts (fired
-- server-side; the server re-validates distance and session ownership, so a
-- hacked client can't vacuum the wreck from the surface). "Surface" or timer
-- expiry ends the dive: payout per treasure, XP for a half-or-better haul,
-- high score = most treasures in one dive.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local TreasureDiving = {}

local context: any = nil
local config: any = nil

type Session = {
	endsAt: number,
	collected: number,
	treasures: { [Part]: boolean },
	folder: Folder,
	returnCFrame: CFrame,
	finished: boolean,
}

local sessions: { [Player]: Session } = {}

local function sendState(player: Player, session: Session)
	context.sendTo(player, {
		phase = "Active",
		timeLeft = math.max(0, math.floor(session.endsAt - os.clock())),
		collected = session.collected,
		total = config.treasureCount,
	})
end

local function endSession(player: Player, session: Session)
	if session.finished then
		return
	end
	session.finished = true
	sessions[player] = nil
	session.folder:Destroy()

	local payout = session.collected * config.payoutPerTreasure
	if payout &gt; 0 then
		context.awardDoubloons(player, payout)
	end
	if session.collected &gt;= math.ceil(config.treasureCount / 2) then
		context.grantWinXP(player)
	end
	context.reportScore(player, session.collected)

	-- Return the diver to the station platform.
	local character = player.Character
	if character and character.Parent then
		character:PivotTo(session.returnCFrame)
	end
	context.sendTo(player, {
		phase = "Done",
		collected = session.collected,
		total = config.treasureCount,
		payout = payout,
	})
end

local function spawnTreasure(player: Player, session: Session, position: Vector3)
	local chest = Instance.new("Part")
	chest.Name = "Treasure"
	chest.Size = Vector3.new(2, 1.4, 1.4)
	chest.Position = position
	chest.Anchored = true
	chest.CanCollide = false
	chest.Color = Color3.fromRGB(240, 195, 80)
	chest.Material = Enum.Material.Neon
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 110)
	light.Range = 12
	light.Parent = chest

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Grab Treasure"
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = chest

	-- ProximityPrompt.Triggered runs on the server; validate the grabber is
	-- THIS session's diver and actually near the chest (anti-exploit).
	prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer ~= player or session.finished or not session.treasures[chest] then
			return
		end
		local character = triggeringPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or (root.Position - chest.Position).Magnitude &gt; config.collectRange then
			return
		end
		session.treasures[chest] = nil
		session.collected += 1
		chest:Destroy()
		sendState(player, session)
	end)

	session.treasures[chest] = true
	chest.Parent = session.folder
end

local function startDive(player: Player)
	if sessions[player] then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return
	end

	local site: Vector3 = GameConfig.WORLD.DIVE_SITE
	local folder = Instance.new("Folder")
	folder.Name = `Dive_{player.UserId}`
	folder.Parent = workspace

	local session: Session = {
		endsAt = os.clock() + config.divingSeconds,
		collected = 0,
		treasures = {},
		folder = folder,
		returnCFrame = root.CFrame,
		finished = false,
	}
	sessions[player] = session

	-- Scatter chests on the seafloor around the wreck.
	for _ = 1, config.treasureCount do
		local angle = math.random() * math.pi * 2
		local radius = 6 + math.random() * (config.scatterRadius - 6)
		spawnTreasure(
			player,
			session,
			site + Vector3.new(math.cos(angle) * radius, 1 + math.random() * 3, math.sin(angle) * radius)
		)
	end

	-- Drop the diver into the water above the wreck.
	character:PivotTo(CFrame.new(site + Vector3.new(0, 18, 0)))
	sendState(player, session)

	-- Air timer + 1s state ticker.
	task.spawn(function()
		while not session.finished do
			task.wait(1)
			if session.finished then
				return
			end
			if os.clock() &gt;= session.endsAt or session.collected &gt;= config.treasureCount or not player.Parent then
				endSession(player, session)
				return
			end
			sendState(player, session)
		end
	end)
end

--------------------------------------------------------------------------------
-- MiniGameManager contract
--------------------------------------------------------------------------------

function TreasureDiving.init(managerContext: any)
	context = managerContext
	config = managerContext.config
	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			session.finished = true
			sessions[player] = nil
			session.folder:Destroy()
		end
	end)
end

function TreasureDiving.handleAction(player: Player, action: string, _payload: any)
	if action == "Start" then
		startDive(player)
	elseif action == "Surface" then
		local session = sessions[player]
		if session then
			endSession(player, session)
		end
	end
end

return TreasureDiving
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">BattlePassService</string><ProtectedString name="Source">--!strict
-- Seasonal battle pass: XP granting and tier claims.
-- XP only ever flows from server-side gameplay events (catches, mini-game
-- wins) — there is no remote to "add XP", only to claim earned tiers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BattlePassConfig = require(Shared.Config.BattlePassConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local BattlePassService = {}

function BattlePassService.grantXP(player: Player, amount: number)
	local data = DataService.get(player)
	if not data or amount &lt;= 0 then
		return
	end
	data.battlePass.xp += math.floor(amount)
	DataService.replicate(player, { "battlePass" })
end

-- Grants a configured reward into the profile. Returns false if the reward is
-- malformed (config typo) so the claim can be refused instead of half-applied.
local function grantReward(player: Player, data: any, reward: any): boolean
	if reward.kind == "Doubloons" then
		return DataService.adjustDoubloons(player, reward.amount or 0)
	elseif reward.kind == "Pearls" then
		return DataService.adjustPearls(player, reward.amount or 0)
	elseif reward.kind == "Bait" then
		if not reward.itemId then
			return false
		end
		data.baitInventory[reward.itemId] = (data.baitInventory[reward.itemId] or 0) + (reward.amount or 1)
		DataService.replicate(player, { "baitInventory" })
		return true
	elseif reward.kind == "BoatSkin" and reward.itemId and MonetizationConfig.BoatSkins[reward.itemId] then
		data.cosmetics.boatSkins[reward.itemId] = true
		DataService.replicate(player, { "cosmetics" })
		return true
	elseif reward.kind == "RodSkin" and reward.itemId and MonetizationConfig.RodSkins[reward.itemId] then
		data.cosmetics.rodSkins[reward.itemId] = true
		DataService.replicate(player, { "cosmetics" })
		return true
	elseif reward.kind == "Pet" and reward.itemId and MonetizationConfig.Pets[reward.itemId] then
		data.cosmetics.pets[reward.itemId] = true
		DataService.replicate(player, { "cosmetics" })
		return true
	end
	return false
end

local function onClaimTier(player: Player, tierIndex: unknown, premium: unknown): any
	local data = DataService.get(player)
	if not data then
		return { ok = false, message = "Data not loaded" }
	end
	if typeof(tierIndex) ~= "number" or tierIndex ~= math.floor(tierIndex) then
		return { ok = false, message = "Invalid tier" }
	end
	local tier = BattlePassConfig.Tiers[tierIndex]
	if not tier then
		return { ok = false, message = "Invalid tier" }
	end
	if data.battlePass.xp &lt; tier.xpRequired then
		return { ok = false, message = "Not enough XP yet" }
	end

	local wantsPremium = premium == true
	local key = tostring(tierIndex)

	if wantsPremium then
		if not data.battlePass.ownsPremium then
			return { ok = false, message = "Premium pass required" }
		end
		if data.battlePass.claimedPremium[key] then
			return { ok = false, message = "Already claimed" }
		end
		local reward = tier.premiumReward
		if not reward then
			return { ok = false, message = "No premium reward at this tier" }
		end
		if not grantReward(player, data, reward) then
			return { ok = false, message = "Reward unavailable" }
		end
		data.battlePass.claimedPremium[key] = true
	else
		if data.battlePass.claimedFree[key] then
			return { ok = false, message = "Already claimed" }
		end
		local reward = tier.freeReward
		if not reward then
			return { ok = false, message = "No free reward at this tier" }
		end
		if not grantReward(player, data, reward) then
			return { ok = false, message = "Reward unavailable" }
		end
		data.battlePass.claimedFree[key] = true
	end

	DataService.replicate(player, { "battlePass" })
	return { ok = true }
end

function BattlePassService.init()
	Remotes.getFunction("ClaimBattlePassTier").OnServerInvoke = onClaimTier
end

return BattlePassService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">BoatService</string><ProtectedString name="Source">--!strict
-- Boat spawning, upgrades (via the physical dockmaster NPC), and the tier-10
-- cruise liner passive income loop.
--
-- Player boats come from ModelFactory (procedural, tier-differentiated). To
-- use hand-built art instead, drop a Model named "BoatModel_&lt;tier&gt;" into
-- ServerStorage (PrimaryPart "Hull" with FloatY/Drive/Steer movers +
-- VehicleSeat "DriverSeat") and it will be preferred automatically.
-- Mini-games can register their own driveable boats via registerExternalBoat
-- so they share the same Heartbeat drive loop.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local BoatConfig = require(Shared.Config.BoatConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ModelFactory = require(script.Parent.ModelFactory)

local BoatService = {}

BoatService.DOCKMASTER_POSITION = GameConfig.WORLD.DOCKMASTER_POSITION
local BOAT_SPAWN = GameConfig.WORLD.BOAT_SPAWN

local boats: { [Player]: Model } = {}
local externalBoats: { [Model]: boolean } = {}

--------------------------------------------------------------------------------
-- Boat construction
--------------------------------------------------------------------------------

local function buildBoat(player: Player, data: any): Model
	local tierDef = assert(BoatConfig.getTier(data.boatTier), "invalid boat tier")

	-- Prefer a hand-built Studio model if one exists.
	local template = ServerStorage:FindFirstChild(`BoatModel_{tierDef.tier}`) :: Model?
	local boat = if template then template:Clone() else ModelFactory.buildBoat(tierDef)

	-- Apply equipped boat skin: recolor every part tagged SkinTarget
	-- (or named "Hull" for hand-built models without tags).
	local skinId = data.cosmetics.equipped.boatSkin
	local skin = skinId and MonetizationConfig.BoatSkins[skinId]
	if skin then
		for _, part in boat:GetDescendants() do
			if part:IsA("BasePart") and (part:GetAttribute("SkinTarget") or part.Name == "Hull") then
				part.Color = skin.color
			end
		end
	end

	boat.Name = `Boat_{player.UserId}`
	boat:SetAttribute("OwnerUserId", player.UserId)
	boat:SetAttribute("Tier", tierDef.tier)
	return boat
end

function BoatService.spawnBoat(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local old = boats[player]
	if old then
		old:Destroy()
	end
	local boat = buildBoat(player, data)
	boat:PivotTo(CFrame.new(BOAT_SPAWN + Vector3.new((player.UserId % 7) * 20 - 60, 0, 0)))
	boat.Parent = workspace
	boats[player] = boat
	Remotes.getEvent("BoatSpawned"):FireClient(player, boat)
end

--------------------------------------------------------------------------------
-- Drive loop (player boats + registered external boats)
--------------------------------------------------------------------------------

-- Mini-games (e.g. Storm Navigation's skiff) opt their boats into the shared
-- drive loop. Unregister (or just Destroy the model) when done.
function BoatService.registerExternalBoat(boat: Model)
	externalBoats[boat] = true
end

function BoatService.unregisterExternalBoat(boat: Model)
	externalBoats[boat] = nil
end

local function driveOne(boat: Model, deltaTime: number)
	local hull = boat.PrimaryPart
	local seat = boat:FindFirstChild("DriverSeat") :: VehicleSeat?
	if not hull or not seat then
		return
	end
	local drive = hull:FindFirstChild("Drive") :: BodyVelocity?
	local steer = hull:FindFirstChild("Steer") :: BodyGyro?
	if not drive or not steer then
		return -- hand-built model bringing its own physics
	end
	local _, yaw, _ = steer.CFrame:ToEulerAnglesYXZ()
	if seat.Occupant then
		-- Steer.CFrame accumulates yaw; throttle pushes along current heading.
		yaw -= seat.Steer * math.rad(45) * deltaTime
		steer.CFrame = CFrame.Angles(0, yaw, 0)
		drive.Velocity = steer.CFrame.LookVector * seat.Throttle * seat.MaxSpeed
	else
		drive.Velocity = Vector3.zero
	end
end

local function driveBoats(deltaTime: number)
	for _, boat in boats do
		driveOne(boat, deltaTime)
	end
	for boat in externalBoats do
		if boat.Parent then
			driveOne(boat, deltaTime)
		else
			externalBoats[boat] = nil -- destroyed; self-clean
		end
	end
end

--------------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------------

local function nearDockmaster(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	return (root.Position - BoatService.DOCKMASTER_POSITION).Magnitude &lt;= GameConfig.DOCK_INTERACT_DISTANCE
end

local function onUpgradeBoat(player: Player): any
	local data = DataService.get(player)
	if not data then
		return { ok = false, message = "Data not loaded" }
	end
	-- Physical interaction requirement: no upgrading from the middle of the ocean.
	if not nearDockmaster(player) then
		return { ok = false, message = "Visit the dockmaster to upgrade your boat." }
	end
	local nextTier = BoatConfig.getTier(data.boatTier + 1)
	if not nextTier then
		return { ok = false, message = "You already own the finest ship on the sea!" }
	end
	-- adjustDoubloons is atomic: it refuses and changes nothing on insufficient funds.
	if not DataService.adjustDoubloons(player, -nextTier.cost) then
		return { ok = false, message = `You need {nextTier.cost} Doubloons for the {nextTier.displayName}.` }
	end
	data.boatTier = nextTier.tier
	DataService.replicate(player, { "boatTier" })
	BoatService.spawnBoat(player)
	Remotes.getEvent("Notify"):FireClient(player, `Upgraded to {nextTier.displayName}!`, "success")
	return { ok = true, newTier = nextTier.tier }
end

--------------------------------------------------------------------------------
-- Cruise liner passive income (endgame reward)
--------------------------------------------------------------------------------

local function passiveIncomeLoop()
	local cfg = GameConfig.CRUISE_PASSIVE
	while true do
		task.wait(cfg.INTERVAL_SECONDS)
		for _, player in Players:GetPlayers() do
			local data = DataService.get(player)
			if data and data.boatTier &gt;= cfg.REQUIRED_TIER then
				DataService.adjustDoubloons(player, cfg.DOUBLOONS_PER_TICK)
				Remotes.getEvent("Notify")
					:FireClient(
						player,
						`Your cruise passengers paid {cfg.DOUBLOONS_PER_TICK} Doubloons in fares!`,
						"info"
					)
			end
		end
	end
end

--------------------------------------------------------------------------------

function BoatService.init()
	Remotes.getFunction("UpgradeBoat").OnServerInvoke = onUpgradeBoat

	-- Spawn a boat once the profile is ready (DataService kicks players whose
	-- data fails to load, so polling get() briefly is safe).
	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			local deadline = os.clock() + 30
			while os.clock() &lt; deadline and player.Parent do
				if DataService.get(player) then
					BoatService.spawnBoat(player)
					return
				end
				task.wait(0.5)
			end
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local boat = boats[player]
		boats[player] = nil
		if boat then
			boat:Destroy()
		end
	end)

	RunService.Heartbeat:Connect(driveBoats)
	task.spawn(passiveIncomeLoop)
end

return BoatService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">DataService</string><ProtectedString name="Source">--!strict
-- Player persistence with session locking and retry/backoff.
--
-- Design (ProfileService-style, self-contained):
--   * Every profile carries a lock {jobId, timestamp}. A server may only load
--     a profile if the lock is free, owned by itself, or stale (&gt; LOCK_TIMEOUT).
--     This prevents the classic dupe: join server B while server A still holds
--     unsaved state, sell items twice, let the stale save overwrite.
--   * All writes go through UpdateAsync so we never blind-Set over newer data.
--   * Autosave loop + PlayerRemoving save + BindToClose flush.
--   * Schema migrations run on load keyed off schemaVersion.
--
-- Other services never touch DataStores; they call DataService.get(player) and
-- mutate through the helpers here so dirty-tracking and replication stay honest.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local BattlePassConfig = require(Shared.Config.BattlePassConfig)
local Remotes = require(Shared.Remotes)

local DataService = {}

local STORE_NAME = "PlayerData_v1"
local SCHEMA_VERSION = 1
local LOCK_TIMEOUT = 30 * 60 -- seconds before a foreign lock is considered stale
local AUTOSAVE_INTERVAL = 120
local MAX_RETRIES = 5

local store = DataStoreService:GetDataStore(STORE_NAME)

export type Profile = {
	data: any, -- Types.PlayerData; `any` here avoids a require cycle in strict mode
	loaded: boolean,
}

local profiles: { [Player]: Profile } = {}

--------------------------------------------------------------------------------
-- Defaults &amp; migrations
--------------------------------------------------------------------------------

local function defaultData(): any
	return {
		schemaVersion = SCHEMA_VERSION,
		doubloons = GameConfig.STARTING_DOUBLOONS,
		pearls = GameConfig.STARTING_PEARLS,
		boatTier = 1,
		rodTier = 1,
		equippedBait = nil,
		baitInventory = {},
		fishInventory = {},
		fishDex = {},
		cosmetics = {
			boatSkins = {},
			rodSkins = {},
			pets = {},
			equipped = {},
		},
		miniGameHighScores = {},
		battlePass = {
			season = BattlePassConfig.SEASON.number,
			xp = 0,
			ownsPremium = false,
			claimedFree = {},
			claimedPremium = {},
		},
		stats = { totalCatches = 0, totalEarned = 0, joinCount = 0 },
		redeemedReceipts = {},
	}
end

-- Runs on every load. Add numbered steps as the schema evolves; never delete old ones.
local function migrate(data: any): any
	-- v0 -&gt; v1 example slot (no-op today):
	-- if (data.schemaVersion or 0) &lt; 1 then ... end
	data.schemaVersion = SCHEMA_VERSION

	-- Season rollover: wipe per-season battle pass progress, keep granted items.
	if data.battlePass.season ~= BattlePassConfig.SEASON.number then
		data.battlePass = {
			season = BattlePassConfig.SEASON.number,
			xp = 0,
			ownsPremium = false, -- premium is per-season by design
			claimedFree = {},
			claimedPremium = {},
		}
	end
	return data
end

--------------------------------------------------------------------------------
-- DataStore plumbing
--------------------------------------------------------------------------------

local function keyFor(userId: number): string
	return "player_" .. tostring(userId)
end

-- UpdateAsync with exponential backoff. Returns (ok, resultOrError).
local function safeUpdate(key: string, transform: (any) -&gt; any?): (boolean, any)
	local delaySeconds = 1
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(function()
			return store:UpdateAsync(key, transform)
		end)
		if ok then
			return true, result
		end
		warn(`[DataService] UpdateAsync failed for {key} (attempt {attempt}): {result}`)
		if attempt &lt; MAX_RETRIES then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 16)
		end
	end
	return false, nil
end

local function acquireProfile(userId: number): (any?, string?)
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	local loadedData: any = nil
	local blocked = false

	local ok = safeUpdate(keyFor(userId), function(stored)
		stored = stored or { data = defaultData(), lock = nil }
		local lock = stored.lock
		local lockIsOurs = lock and lock.jobId == jobId
		local lockIsStale = lock and (os.time() - (lock.timestamp or 0)) &gt; LOCK_TIMEOUT
		if lock and not lockIsOurs and not lockIsStale then
			-- Another live server owns this profile. Abort the write.
			blocked = true
			return nil
		end
		stored.lock = { jobId = jobId, timestamp = os.time() }
		loadedData = stored.data
		return stored
	end)

	if not ok then
		return nil, "DataStore unavailable"
	end
	if blocked then
		return nil, "Profile is locked by another server"
	end
	return migrate(loadedData or defaultData()), nil
end

local function writeProfile(userId: number, data: any, releaseLock: boolean): boolean
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	local ok = safeUpdate(keyFor(userId), function(stored)
		stored = stored or {}
		-- Only write if we still own (or nobody owns) the lock — a stale-lock
		-- takeover by another server must not be clobbered.
		local lock = stored.lock
		if lock and lock.jobId ~= jobId then
			return nil
		end
		stored.data = data
		stored.lock = if releaseLock then nil else { jobId = jobId, timestamp = os.time() }
		return stored
	end)
	return ok
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

-- Returns live PlayerData or nil if the profile hasn't loaded (callers must
-- treat nil as "reject the request", never fall back to defaults).
function DataService.get(player: Player): any?
	local profile = profiles[player]
	if profile and profile.loaded then
		return profile.data
	end
	return nil
end

-- Push a partial snapshot to the owning client. Services call this after any
-- mutation the HUD/UI cares about; keys mirror PlayerData fields.
function DataService.replicate(player: Player, keys: { string }?)
	local data = DataService.get(player)
	if not data then
		return
	end
	local snapshot: { [string]: any } = {}
	if keys then
		for _, key in keys do
			snapshot[key] = data[key]
		end
	else
		for key, value in data do
			snapshot[key] = value
		end
	end
	Remotes.getEvent("DataChanged"):FireClient(player, snapshot)
end

-- Currency helpers: the ONLY sanctioned way to change balances. Amount may be
-- negative; returns false (and changes nothing) if funds are insufficient.
function DataService.adjustDoubloons(player: Player, amount: number): boolean
	local data = DataService.get(player)
	if not data then
		return false
	end
	local newBalance = data.doubloons + amount
	if newBalance &lt; 0 then
		return false
	end
	data.doubloons = math.floor(newBalance)
	if amount &gt; 0 then
		data.stats.totalEarned += amount
	end
	DataService.replicate(player, { "doubloons", "stats" })
	return true
end

function DataService.adjustPearls(player: Player, amount: number): boolean
	local data = DataService.get(player)
	if not data then
		return false
	end
	local newBalance = data.pearls + amount
	if newBalance &lt; 0 then
		return false
	end
	data.pearls = math.floor(newBalance)
	DataService.replicate(player, { "pearls" })
	return true
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local data, err = acquireProfile(player.UserId)
	if not data then
		warn(`[DataService] Failed to load {player.Name}: {err}`)
		player:Kick("Your data could not be loaded safely. Please rejoin in a minute.")
		return
	end
	if not player.Parent then
		-- Player left mid-load; release the lock we just took.
		writeProfile(player.UserId, data, true)
		return
	end
	data.stats.joinCount += 1
	profiles[player] = { data = data, loaded = true }
	DataService.replicate(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	profiles[player] = nil
	if profile and profile.loaded then
		task.spawn(function()
			if not writeProfile(player.UserId, profile.data, true) then
				warn(`[DataService] FINAL SAVE FAILED for {player.Name} ({player.UserId})`)
			end
		end)
	end
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- Autosave (keeps the lock; refreshes its timestamp so it never goes stale mid-session)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, profile in profiles do
				if profile.loaded then
					writeProfile(player.UserId, profile.data, false)
				end
			end
		end
	end)

	-- Flush everything on shutdown. Studio gets a short grace period.
	game:BindToClose(function()
		if RunService:IsStudio() then
			task.wait(2)
		end
		local pending = 0
		for player, profile in profiles do
			if profile.loaded then
				pending += 1
				task.spawn(function()
					writeProfile(player.UserId, profile.data, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">--!strict
-- Doubloon-economy purchases that aren't boats: rod upgrades, bait, plus
-- cosmetic buy/equip (Pearls). Every path validates server-side — the client
-- request is only ever an id, never a price.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local BaitConfig = require(Shared.Config.BaitConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local BoatService = require(script.Parent.BoatService)

local EconomyService = {}

local MAX_BAIT_PER_PURCHASE = 100

--------------------------------------------------------------------------------
-- Rod upgrades
--------------------------------------------------------------------------------

local function onUpgradeRod(player: Player): any
	local data = DataService.get(player)
	if not data then
		return { ok = false, message = "Data not loaded" }
	end
	local nextTier = GameConfig.ROD_TIERS[data.rodTier + 1]
	if not nextTier then
		return { ok = false, message = "Your rod is already the best there is." }
	end
	if not DataService.adjustDoubloons(player, -nextTier.cost) then
		return { ok = false, message = `You need {nextTier.cost} Doubloons for the {nextTier.name}.` }
	end
	data.rodTier += 1
	DataService.replicate(player, { "rodTier" })
	return { ok = true, newTier = data.rodTier }
end

--------------------------------------------------------------------------------
-- Bait
--------------------------------------------------------------------------------

local function onBuyBait(player: Player, baitId: unknown, amount: unknown): any
	local data = DataService.get(player)
	if not data then
		return { ok = false, message = "Data not loaded" }
	end
	local bait = typeof(baitId) == "string" and BaitConfig.getBait(baitId) or nil
	if not bait then
		return { ok = false, message = "Unknown bait" }
	end
	local quantity = typeof(amount) == "number" and math.floor(amount) or 0
	if quantity &lt; 1 or quantity &gt; MAX_BAIT_PER_PURCHASE then
		return { ok = false, message = "Invalid amount" }
	end
	local totalCost = bait.cost * quantity
	if not DataService.adjustDoubloons(player, -totalCost) then
		return { ok = false, message = `That costs {totalCost} Doubloons.` }
	end
	data.baitInventory[bait.id] = (data.baitInventory[bait.id] or 0) + quantity
	DataService.replicate(player, { "baitInventory" })
	return { ok = true, message = `Bought {quantity}x {bait.displayName}.` }
end

local function onEquipBait(player: Player, baitId: unknown): any
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	if baitId == nil then
		data.equippedBait = nil
	else
		if typeof(baitId) ~= "string" or (data.baitInventory[baitId] or 0) &lt;= 0 then
			return { ok = false }
		end
		data.equippedBait = baitId
	end
	DataService.replicate(player, { "equippedBait" })
	return { ok = true }
end

--------------------------------------------------------------------------------
-- Cosmetics (Pearls) — buy &amp; equip
--------------------------------------------------------------------------------

type CosmeticCategory = "boatSkin" | "rodSkin" | "pet"

local function catalogFor(category: string): (any?, string?)
	if category == "boatSkin" then
		return MonetizationConfig.BoatSkins, "boatSkins"
	elseif category == "rodSkin" then
		return MonetizationConfig.RodSkins, "rodSkins"
	elseif category == "pet" then
		return MonetizationConfig.Pets, "pets"
	end
	return nil, nil
end

local function onBuyCosmetic(player: Player, category: unknown, itemId: unknown): any
	local data = DataService.get(player)
	if not data then
		return { ok = false, message = "Data not loaded" }
	end
	if typeof(category) ~= "string" or typeof(itemId) ~= "string" then
		return { ok = false, message = "Invalid request" }
	end
	local catalog, ownedKey = catalogFor(category)
	if not catalog or not ownedKey then
		return { ok = false, message = "Invalid category" }
	end
	local item = catalog[itemId]
	if not item then
		return { ok = false, message = "Unknown item" }
	end
	if data.cosmetics[ownedKey][itemId] then
		return { ok = false, message = "Already owned" }
	end
	local cost = item.pearlCost or item.premiumCost or 0
	if not DataService.adjustPearls(player, -cost) then
		return { ok = false, message = `You need {cost} Pearls.` }
	end
	data.cosmetics[ownedKey][itemId] = true
	DataService.replicate(player, { "cosmetics" })
	return { ok = true, message = `Purchased {item.displayName}!` }
end

local function onEquipCosmetic(player: Player, category: unknown, itemId: unknown): any
	local data = DataService.get(player)
	if not data then
		return { ok = false }
	end
	if typeof(category) ~= "string" then
		return { ok = false }
	end
	local catalog, ownedKey = catalogFor(category)
	if not catalog or not ownedKey then
		return { ok = false }
	end
	if itemId ~= nil then
		if typeof(itemId) ~= "string" or not data.cosmetics[ownedKey][itemId] then
			return { ok = false } -- can only equip what you own
		end
	end
	data.cosmetics.equipped[category] = itemId
	DataService.replicate(player, { "cosmetics" })
	if category == "boatSkin" then
		BoatService.spawnBoat(player) -- respawn to apply the new hull paint
	end
	return { ok = true }
end

--------------------------------------------------------------------------------

function EconomyService.init()
	Remotes.getFunction("UpgradeRod").OnServerInvoke = onUpgradeRod
	Remotes.getFunction("BuyBait").OnServerInvoke = onBuyBait
	Remotes.getFunction("EquipBait").OnServerInvoke = onEquipBait
	Remotes.getFunction("BuyCosmetic").OnServerInvoke = onBuyCosmetic
	Remotes.getFunction("EquipCosmetic").OnServerInvoke = onEquipCosmetic

	-- Full-snapshot fetch for UI boot.
	Remotes.getFunction("GetData").OnServerInvoke = function(player: Player)
		return DataService.get(player)
	end
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">FishingService</string><ProtectedString name="Source">--!strict
-- Server-authoritative fishing loop.
--
-- State machine per player: Idle -&gt; WaitingBite -&gt; Reeling -&gt; Idle.
-- The client only ever sends *intents* (cast, reel accuracy); the server:
--   * validates zone access against boat tier and character position
--   * rolls the fish (rarity -&gt; species -&gt; weight) entirely server-side
--   * enforces cast cooldowns, reel time windows, and storage capacity
-- A hacked client can therefore never choose its fish, skip the wait, or
-- exceed its cargo hold.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local FishConfig = require(Shared.Config.FishConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local BaitConfig = require(Shared.Config.BaitConfig)
local BoatConfig = require(Shared.Config.BoatConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Remotes = require(Shared.Remotes)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local DataService = require(script.Parent.DataService)
local BattlePassService = require(script.Parent.BattlePassService)

local FishingService = {}

type FishingState = {
	phase: "Idle" | "WaitingBite" | "Reeling",
	lastCastAt: number,
	biteAt: number, -- os.clock() when the bite fired
	castId: number, -- monotonically increasing; stale delayed threads compare it
	pendingFishId: string?,
	pendingZoneId: string?,
}

local states: { [Player]: FishingState } = {}

local function getState(player: Player): FishingState
	local state = states[player]
	if not state then
		state = { phase = "Idle", lastCastAt = 0, biteAt = 0, castId = 0 }
		states[player] = state
	end
	return state
end

--------------------------------------------------------------------------------
-- Luck &amp; rolls
--------------------------------------------------------------------------------

-- Total luck = rod + equipped bait + equipped pet (pet capped in config).
local function computeLuck(data: any): number
	local rod = GameConfig.ROD_TIERS[data.rodTier]
	local luck = rod and rod.luckBonus or 0
	local bait = BaitConfig.getBait(data.equippedBait)
	if bait then
		luck += bait.luckBonus
	end
	local petId = data.cosmetics.equipped.pet
	local pet = petId and MonetizationConfig.Pets[petId]
	if pet then
		luck += math.min(pet.luckBonus, MonetizationConfig.MAX_PET_LUCK)
	end
	return math.clamp(luck, 0, 1)
end

local function rollFish(zoneId: string, luck: number): string?
	local zone = ZoneConfig.getZone(zoneId)
	local pools = FishConfig.ZoneRarityPools[zoneId]
	if not zone or not pools then
		return nil
	end
	-- Ordered common-&gt;rare so WeightedRandom's luck skew helps rarity.
	local entries = {}
	for _, rarity in FishConfig.RARITY_ORDER do
		local weight = zone.rarityWeights[rarity] or 0
		if weight &gt; 0 and pools[rarity] and #pools[rarity] &gt; 0 then
			table.insert(entries, { value = rarity, weight = weight })
		end
	end
	local rarity = WeightedRandom.pick(entries, luck)
	if not rarity then
		return nil
	end
	local pool = pools[rarity :: any]
	return pool[math.random(1, #pool)]
end

--------------------------------------------------------------------------------
-- Cast / bite / reel
--------------------------------------------------------------------------------

local function playerZone(player: Player): string?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	return ZoneConfig.zoneAtPosition(root.Position)
end

local function onCastRequest(player: Player)
	local data = DataService.get(player)
	local state = getState(player)
	if not data or state.phase ~= "Idle" then
		return
	end
	if os.clock() - state.lastCastAt &lt; GameConfig.CAST_COOLDOWN then
		return
	end

	-- Zone gating: must physically be in a zone their boat tier allows.
	local zoneId = playerZone(player)
	local zone = zoneId and ZoneConfig.getZone(zoneId)
	if not zoneId or not zone then
		Remotes.getEvent("Notify"):FireClient(player, "You need to be on the water to fish.", "error")
		return
	end
	if data.boatTier &lt; zone.requiredBoatTier then
		Remotes.getEvent("Notify"):FireClient(player, `Your boat can't handle {zone.displayName} yet.`, "error")
		return
	end

	-- Storage gating against the CURRENT boat's hold.
	local boat = BoatConfig.getTier(data.boatTier)
	if boat and #data.fishInventory &gt;= boat.storage then
		Remotes.getEvent("Notify"):FireClient(player, "Your hold is full! Sell your catch at the market dock.", "error")
		return
	end

	state.phase = "WaitingBite"
	state.lastCastAt = os.clock()
	state.castId += 1
	local thisCast = state.castId

	-- Consume bait NOW (cast = commitment) and compute bite delay.
	local bait = BaitConfig.getBait(data.equippedBait)
	local biteMultiplier = 1
	if bait then
		local held = data.baitInventory[bait.id] or 0
		if held &gt; 0 then
			data.baitInventory[bait.id] = held - 1
			biteMultiplier = bait.biteSpeedMultiplier
			if data.baitInventory[bait.id] == 0 then
				data.equippedBait = nil
			end
			DataService.replicate(player, { "baitInventory", "equippedBait" })
		else
			data.equippedBait = nil -- had it equipped but none left
		end
	end

	local luck = computeLuck(data)
	local delaySeconds = WeightedRandom.range(zone.biteTimeRange.min, zone.biteTimeRange.max) * biteMultiplier

	task.delay(delaySeconds, function()
		-- castId guard: if this cast was cancelled and a new one started, this
		-- stale thread must not fire a bite into the new cast.
		if state.phase ~= "WaitingBite" or state.castId ~= thisCast or not player.Parent then
			return
		end
		-- Roll the fish server-side at bite time; the client learns nothing
		-- about it until the reel resolves.
		state.pendingFishId = rollFish(zoneId, luck)
		state.pendingZoneId = zoneId
		state.phase = "Reeling"
		state.biteAt = os.clock()

		local rod = GameConfig.ROD_TIERS[data.rodTier]
		Remotes.getEvent("BiteAlert"):FireClient(player, {
			sweetSpotSize = rod and rod.sweetSpotSize or 0.18,
			timeLimit = GameConfig.REEL_TIME_LIMIT,
		})

		-- Auto-fail if the client never reports back.
		task.delay(GameConfig.REEL_TIME_LIMIT + 1, function()
			if state.phase == "Reeling" and state.castId == thisCast then
				state.phase = "Idle"
				state.pendingFishId = nil
				Remotes.getEvent("CatchResult"):FireClient(player, nil, true)
			end
		end)
	end)
end

local function onCancelCast(player: Player)
	local state = getState(player)
	if state.phase == "WaitingBite" then
		state.phase = "Idle"
		state.pendingFishId = nil
	end
end

local function onReelResult(player: Player, accuracy: unknown)
	local data = DataService.get(player)
	local state = getState(player)
	if not data or state.phase ~= "Reeling" then
		return
	end

	-- Timing window validation: too fast is an exploit, too slow already failed.
	local elapsed = os.clock() - state.biteAt
	if elapsed &lt; GameConfig.REEL_MIN_TIME or elapsed &gt; GameConfig.REEL_TIME_LIMIT then
		state.phase = "Idle"
		state.pendingFishId = nil
		Remotes.getEvent("CatchResult"):FireClient(player, nil, true)
		return
	end

	-- Sanitize the client-reported accuracy. It only shapes weight, never
	-- rarity — worst case a spoofed 1.0 yields a slightly heavier fish.
	local clampedAccuracy = 0
	if typeof(accuracy) == "number" and accuracy == accuracy then
		clampedAccuracy = math.clamp(accuracy, 0, 1)
	end

	local fishId = state.pendingFishId
	local zoneId = state.pendingZoneId or "StarterBay"
	state.phase = "Idle"
	state.pendingFishId = nil
	state.pendingZoneId = nil

	local fishDef = fishId and FishConfig.getFish(fishId)
	-- Escape chance: missing the sweet spot entirely (accuracy 0) always loses
	-- the fish; partial accuracy gives a proportional chance to land it.
	if not fishId or not fishDef or clampedAccuracy &lt;= 0 or math.random() &gt; (0.25 + clampedAccuracy * 0.75) then
		Remotes.getEvent("CatchResult"):FireClient(player, nil, true)
		return
	end

	local weight = WeightedRandom.biasedRange(
		fishDef.minWeight,
		fishDef.maxWeight,
		clampedAccuracy * GameConfig.ACCURACY_WEIGHT_BONUS
	)
	weight = math.floor(weight * 100) / 100

	local catch = {
		fishId = fishId,
		weight = weight,
		caughtAt = os.time(),
		zoneId = zoneId,
	}
	table.insert(data.fishInventory, catch)

	-- Dex tracking
	local entry = data.fishDex[fishId]
	if entry then
		entry.caught += 1
		entry.bestWeight = math.max(entry.bestWeight, weight)
	else
		data.fishDex[fishId] = { caught = 1, bestWeight = weight, firstCaughtAt = os.time() }
		Remotes.getEvent("Notify"):FireClient(player, `New species discovered: {fishDef.displayName}!`, "success")
	end
	data.stats.totalCatches += 1

	BattlePassService.grantXP(player, GameConfig.XP_PER_CATCH[fishDef.rarity] or 5)
	DataService.replicate(player, { "fishInventory", "fishDex", "stats" })
	Remotes.getEvent("CatchResult"):FireClient(player, catch, false)
end

--------------------------------------------------------------------------------

function FishingService.init()
	Remotes.getEvent("CastRequest").OnServerEvent:Connect(onCastRequest)
	Remotes.getEvent("CancelCast").OnServerEvent:Connect(onCancelCast)
	Remotes.getEvent("ReelResult").OnServerEvent:Connect(onReelResult)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return FishingService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">MarketService</string><ProtectedString name="Source">--!strict
-- Fish selling + a lightweight supply/demand simulation.
--
-- Each rarity has a demand multiplier that starts at 1.0, takes a hit for
-- every fish of that rarity sold on this server, and recovers linearly over
-- time (plus a small random drift so prices feel alive even in quiet servers).
-- Sell price = baseValue * rarityMult * weightFactor * zonePayout * demand * petBonus.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local FishConfig = require(Shared.Config.FishConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local MarketService = {}

local MARKET = GameConfig.MARKET

-- Live demand state per rarity (server-local by design: each server is its own
-- little fish market, which also spreads load across the shard).
local demand: { [string]: number } = {}
for _, rarity in FishConfig.RARITY_ORDER do
	demand[rarity] = 1
end

-- World anchor for the market dock; the sell remote validates proximity so the
-- interaction stays physical. WorldService creates the NPC here.
MarketService.DOCK_POSITION = GameConfig.WORLD.MARKET_POSITION

local function recoverAndDrift()
	while true do
		task.wait(MARKET.DRIFT_INTERVAL)
		local recovery = MARKET.DRIFT_INTERVAL / MARKET.RECOVERY_SECONDS
		for rarity, value in demand do
			local drifted = value + recovery + (math.random() * 2 - 1) * MARKET.DRIFT_MAGNITUDE
			demand[rarity] = math.clamp(drifted, MARKET.MIN_DEMAND, MARKET.MAX_DEMAND)
		end
	end
end

function MarketService.priceFor(data: any, catch: any): number
	local def = FishConfig.getFish(catch.fishId)
	if not def then
		return 0
	end
	local rarityInfo = FishConfig.RARITY_INFO[def.rarity]
	local zone = ZoneConfig.getZone(catch.zoneId)
	-- Weight factor: average-weight fish = 1.0, trophy weight up to 2.0.
	local weightSpan = math.max(def.maxWeight - def.minWeight, 0.01)
	local weightFactor = 0.5 + (catch.weight - def.minWeight) / weightSpan * 1.5

	local petBonus = 1
	local petId = data.cosmetics.equipped.pet
	local pet = petId and MonetizationConfig.Pets[petId]
	if pet then
		petBonus += math.min(pet.sellBonus, MonetizationConfig.MAX_PET_SELL_BONUS)
	end

	local price = def.baseValue
		* rarityInfo.valueMult
		* weightFactor
		* (zone and zone.payoutMultiplier or 1)
		* demand[def.rarity]
		* petBonus
	return math.max(1, math.floor(price))
end

local function nearDock(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	return (root.Position - MarketService.DOCK_POSITION).Magnitude &lt;= GameConfig.DOCK_INTERACT_DISTANCE
end

local function onSellAllFish(player: Player): any
	local data = DataService.get(player)
	if not data then
		return { ok = false, message = "Data not loaded" }
	end
	if not nearDock(player) then
		return { ok = false, message = "Sail to the market dock to sell." }
	end
	if #data.fishInventory == 0 then
		return { ok = false, message = "Your hold is empty." }
	end

	local earned = 0
	for _, catch in data.fishInventory do
		earned += MarketService.priceFor(data, catch)
		-- Every sale nudges that rarity's demand down.
		local def = FishConfig.getFish(catch.fishId)
		if def then
			demand[def.rarity] =
				math.clamp(demand[def.rarity] - MARKET.DEMAND_HIT_PER_SALE, MARKET.MIN_DEMAND, MARKET.MAX_DEMAND)
		end
	end

	local count = #data.fishInventory
	data.fishInventory = {}
	DataService.adjustDoubloons(player, earned)
	DataService.replicate(player, { "fishInventory" })
	return { ok = true, earned = earned, message = `Sold {count} fish for {earned} Doubloons!` }
end

local function onGetMarketPrices(_player: Player): any
	-- Shallow copy so the client can't mutate server state via the reference.
	local snapshot = {}
	for rarity, value in demand do
		snapshot[rarity] = math.floor(value * 100) / 100
	end
	return snapshot
end

function MarketService.init()
	Remotes.getFunction("SellAllFish").OnServerInvoke = onSellAllFish
	Remotes.getFunction("GetMarketPrices").OnServerInvoke = onGetMarketPrices
	task.spawn(recoverAndDrift)
end

return MarketService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">MiniGameManager</string><ProtectedString name="Source">--!strict
-- Registry + router for mini-games.
--
-- CONTRACT — each module in ./MiniGames/&lt;id&gt;.luau returns a table with:
--   init(context) -&gt; ()        called once at server start
--   handleAction(player, action: string, payload: any) -&gt; ()
--                              all client input for that game, pre-routed
-- and receives a `context` with:
--   config          the entry from MiniGameConfig.Games[id].config
--   broadcast(state) fires MiniGameState(gameId, state) to all clients
--   sendTo(player, state)      same but to one client
--   awardDoubloons(player, n)  the ONLY payout path (goes through DataService)
--   chargeDoubloons(player, n) -&gt; boolean  for entry fees / bets
--   grantWinXP(player)         battle pass XP for a win
--   reportScore(player, score) updates the persisted high score if beaten
--
-- Adding a game = new config entry + new module. Nothing else changes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local MiniGameConfig = require(Shared.Config.MiniGameConfig)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local BattlePassService = require(script.Parent.BattlePassService)

local MiniGameManager = {}

export type MiniGameContext = {
	config: any,
	broadcast: (state: any) -&gt; (),
	sendTo: (player: Player, state: any) -&gt; (),
	awardDoubloons: (player: Player, amount: number) -&gt; (),
	chargeDoubloons: (player: Player, amount: number) -&gt; boolean,
	grantWinXP: (player: Player) -&gt; (),
	reportScore: (player: Player, score: number) -&gt; (),
}

local games: { [string]: any } = {}

local function makeContext(gameId: string): MiniGameContext
	local entry = MiniGameConfig.Games[gameId]
	return {
		config = entry.config,
		broadcast = function(state)
			Remotes.getEvent("MiniGameState"):FireAllClients(gameId, state)
		end,
		sendTo = function(player, state)
			Remotes.getEvent("MiniGameState"):FireClient(player, gameId, state)
		end,
		awardDoubloons = function(player, amount)
			if amount &gt; 0 then
				DataService.adjustDoubloons(player, math.floor(amount))
			end
		end,
		chargeDoubloons = function(player, amount)
			return amount &gt; 0 and DataService.adjustDoubloons(player, -math.floor(amount))
		end,
		grantWinXP = function(player)
			BattlePassService.grantXP(player, GameConfig.XP_PER_MINIGAME_WIN)
		end,
		reportScore = function(player, score)
			local data = DataService.get(player)
			if data and score &gt; (data.miniGameHighScores[gameId] or 0) then
				data.miniGameHighScores[gameId] = score
				DataService.replicate(player, { "miniGameHighScores" })
			end
		end,
	}
end

function MiniGameManager.init()
	for gameId, entry in MiniGameConfig.Games do
		if not entry.enabled then
			continue
		end
		local moduleInstance = script.Parent.MiniGames:FindFirstChild(gameId)
		if not moduleInstance then
			warn(`[MiniGameManager] Enabled game '{gameId}' has no module — skipping`)
			continue
		end
		local ok, gameModule = pcall(require, moduleInstance)
		if not ok then
			warn(`[MiniGameManager] Failed to load '{gameId}': {gameModule}`)
			continue
		end
		games[gameId] = gameModule
		gameModule.init(makeContext(gameId))
	end

	Remotes.getEvent("MiniGameAction").OnServerEvent:Connect(function(player, gameId, action, payload)
		if typeof(gameId) ~= "string" or typeof(action) ~= "string" then
			return
		end
		local gameModule = games[gameId]
		if gameModule then
			gameModule.handleAction(player, action, payload)
		end
	end)
end

return MiniGameManager
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">ModelFactory</string><ProtectedString name="Source">--!strict
-- Procedural placeholder-plus models: boats that visibly evolve per tier,
-- blocky NPC characters, follower pets, race crabs, and buoys.
-- These are deliberately simple part-built models so the game ships with zero
-- uploaded assets; swap any of them for real meshes later without touching
-- game logic (the contracts are just part names + attributes).

local ModelFactory = {}

type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	shape: ("Block" | "Ball" | "Cylinder" | "Wedge")?,
	anchored: boolean?,
	canCollide: boolean?,
}

local function makePart(props: PartProps): BasePart
	local part: BasePart
	if props.shape == "Wedge" then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if props.shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif props.shape == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
		part = p
	end
	part.Name = props.name or "Part"
	part.Size = props.size
	part.CFrame = props.cframe
	part.Color = props.color or Color3.fromRGB(128, 128, 128)
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.Anchored = props.anchored ~= false
	part.CanCollide = props.canCollide ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function weldTo(root: BasePart, part: BasePart)
	part.Anchored = false
	part.Massless = true -- decorations must not change hull physics
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = root
end

--------------------------------------------------------------------------------
-- Boats
--------------------------------------------------------------------------------

-- Builds a driveable boat from a BoatConfig-style tier def. Contract with
-- BoatService: PrimaryPart "Hull" (movers FloatY/Drive/Steer attached),
-- VehicleSeat "DriverSeat", skinnable parts tagged with the SkinTarget
-- attribute. Bow faces -Z.
function ModelFactory.buildBoat(tierDef: any): Model
	local size: Vector3 = tierDef.appearance.size
	local color: Color3 = tierDef.appearance.color
	local tier: number = tierDef.tier or 1

	local model = Instance.new("Model")
	model.Name = "Boat"

	local hull = makePart({
		name = "Hull",
		size = size,
		cframe = CFrame.new(),
		color = color,
		material = if tier &lt;= 2 then Enum.Material.WoodPlanks else Enum.Material.SmoothPlastic,
		anchored = false,
	})
	hull:SetAttribute("SkinTarget", true)
	hull.Parent = model
	model.PrimaryPart = hull

	-- Bow wedge (orientation is cosmetic; slope points forward).
	local bowLength = size.Z * 0.3
	local bow = makePart({
		name = "Bow",
		size = Vector3.new(size.X, size.Y, bowLength),
		cframe = CFrame.new(0, 0, -(size.Z / 2 + bowLength / 2)) * CFrame.Angles(0, math.pi, 0),
		color = color,
		material = hull.Material,
		shape = "Wedge",
	})
	bow:SetAttribute("SkinTarget", true)
	weldTo(hull, bow)
	bow.Parent = model

	-- Deck: lighter strip on top.
	local deck = makePart({
		name = "Deck",
		size = Vector3.new(size.X * 0.85, 0.4, size.Z * 0.9),
		cframe = CFrame.new(0, size.Y / 2 + 0.2, 0),
		color = Color3.fromRGB(190, 160, 110),
		material = Enum.Material.WoodPlanks,
	})
	weldTo(hull, deck)
	deck.Parent = model

	-- Driver seat: rear-center of the deck, facing the bow (-Z).
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 1, 2)
	seat.MaxSpeed = tierDef.speed
	seat.Torque = 10
	seat.TurnSpeed = 20
	seat.Color = Color3.fromRGB(60, 50, 40)
	seat.CFrame = CFrame.new(0, size.Y / 2 + 0.9, size.Z * 0.3)
	weldTo(hull, seat)
	seat.Parent = model

	-- Tier 4+: cabin with a dark windshield.
	if tier &gt;= 4 then
		local cabinSize = Vector3.new(size.X * 0.6, math.max(size.Y * 0.9, 2.4), size.Z * 0.22)
		local cabin = makePart({
			name = "Cabin",
			size = cabinSize,
			cframe = CFrame.new(0, size.Y / 2 + cabinSize.Y / 2 + 0.4, -size.Z * 0.05),
			color = if tier &gt;= 9 then Color3.fromRGB(245, 245, 250) else color:Lerp(Color3.new(1, 1, 1), 0.25),
			material = Enum.Material.SmoothPlastic,
		})
		cabin:SetAttribute("SkinTarget", true)
		weldTo(hull, cabin)
		cabin.Parent = model

		local windshield = makePart({
			name = "Windshield",
			size = Vector3.new(cabinSize.X * 0.85, cabinSize.Y * 0.45, 0.2),
			cframe = cabin.CFrame * CFrame.new(0, cabinSize.Y * 0.15, -cabinSize.Z / 2 - 0.1),
			color = Color3.fromRGB(40, 60, 90),
			material = Enum.Material.Glass,
			transparency = 0.3,
		})
		weldTo(hull, windshield)
		windshield.Parent = model
	end

	-- Tier 7+: sonar mast with a radar ball.
	if tier &gt;= 7 then
		local mastHeight = size.Y + 4
		local mast = makePart({
			name = "Mast",
			size = Vector3.new(0.4, mastHeight, 0.4),
			cframe = CFrame.new(0, size.Y / 2 + mastHeight / 2, size.Z * 0.12),
			color = Color3.fromRGB(90, 90, 100),
		})
		weldTo(hull, mast)
		mast.Parent = model
		local radar = makePart({
			name = "Radar",
			size = Vector3.new(1.4, 1.4, 1.4),
			cframe = mast.CFrame * CFrame.new(0, mastHeight / 2 + 0.7, 0),
			color = Color3.fromRGB(230, 230, 235),
			shape = "Ball",
		})
		weldTo(hull, radar)
		radar.Parent = model
	end

	-- Tier 9+: long dark window stripes along each side (yacht/liner look).
	if tier &gt;= 9 then
		for _, xSign in { -1, 1 } do
			local stripe = makePart({
				name = "WindowStripe",
				size = Vector3.new(0.2, size.Y * 0.25, size.Z * 0.7),
				cframe = CFrame.new(xSign * (size.X / 2 + 0.1), size.Y * 0.15, 0),
				color = Color3.fromRGB(35, 45, 70),
				material = Enum.Material.Glass,
				transparency = 0.2,
			})
			weldTo(hull, stripe)
			stripe.Parent = model
		end
	end

	-- Tier 10: cruise liner superstructure + two red funnels.
	if tier == 10 then
		local upperDeck = makePart({
			name = "UpperDeck",
			size = Vector3.new(size.X * 0.75, 3, size.Z * 0.6),
			cframe = CFrame.new(0, size.Y / 2 + 4.4, size.Z * 0.02),
			color = Color3.fromRGB(250, 250, 255),
		})
		upperDeck:SetAttribute("SkinTarget", true)
		weldTo(hull, upperDeck)
		upperDeck.Parent = model
		for index, zOffset in { -size.Z * 0.12, size.Z * 0.12 } do
			local funnel = makePart({
				name = `Funnel{index}`,
				size = Vector3.new(2.2, 5, 2.2),
				cframe = CFrame.new(0, size.Y / 2 + 8.4, zOffset),
				color = Color3.fromRGB(200, 60, 60),
				shape = "Cylinder",
			})
			-- Cylinders lie along X by default; stand it upright.
			funnel.CFrame *= CFrame.Angles(0, 0, math.rad(90))
			weldTo(hull, funnel)
			funnel.Parent = model
		end
	end

	-- Physics movers (Y float + XZ drive + yaw steer), driven by
	-- BoatService.driveBoats. BodyMovers are deprecated-but-stable; they keep
	-- greybox physics dead simple. Swap for constraints during a physics pass.
	local float = Instance.new("BodyPosition")
	float.Name = "FloatY"
	float.MaxForce = Vector3.new(0, math.huge, 0)
	float.Position = Vector3.new(0, 2, 0)
	float.Parent = hull

	local drive = Instance.new("BodyVelocity")
	drive.Name = "Drive"
	drive.MaxForce = Vector3.new(1e6, 0, 1e6)
	drive.Velocity = Vector3.zero
	drive.Parent = hull

	local steer = Instance.new("BodyGyro")
	steer.Name = "Steer"
	steer.MaxTorque = Vector3.new(1e6, 1e7, 1e6)
	steer.CFrame = CFrame.new()
	steer.Parent = hull

	return model
end

--------------------------------------------------------------------------------
-- NPCs
--------------------------------------------------------------------------------

-- Blocky anchored character statue (R6 proportions). Returns the model; the
-- caller attaches billboards/prompts (that contract lives in WorldService).
function ModelFactory.buildNPC(name: string, outfitColor: Color3, position: Vector3, facingYaw: number?): Model
	local model = Instance.new("Model")
	model.Name = name
	local base = CFrame.new(position) * CFrame.Angles(0, facingYaw or 0, 0)
	local skin = Color3.fromRGB(234, 184, 146)
	local pants = Color3.fromRGB(50, 60, 75)

	local torso = makePart({
		name = "Torso",
		size = Vector3.new(2, 2, 1),
		cframe = base * CFrame.new(0, 3, 0),
		color = outfitColor,
	})
	torso.Parent = model
	model.PrimaryPart = torso

	makePart({
		name = "Head",
		size = Vector3.new(1.2, 1.2, 1.2),
		cframe = base * CFrame.new(0, 4.6, 0),
		color = skin,
	}).Parent =
		model

	for _, side in { -1, 1 } do
		makePart({
			name = "Arm",
			size = Vector3.new(0.9, 2, 0.9),
			cframe = base * CFrame.new(side * 1.45, 3, 0),
			color = outfitColor,
		}).Parent =
			model
		makePart({
			name = "Leg",
			size = Vector3.new(0.9, 2, 0.9),
			cframe = base * CFrame.new(side * 0.5, 1, 0),
			color = pants,
		}).Parent =
			model
	end
	return model
end

--------------------------------------------------------------------------------
-- Pets (all-anchored; PetService PivotTo's the whole model to follow)
--------------------------------------------------------------------------------

function ModelFactory.buildPet(petId: string): Model
	local model = Instance.new("Model")
	model.Name = `Pet_{petId}`

	local body: BasePart
	if petId == "Crab" then
		body = makePart({
			name = "Body",
			size = Vector3.new(1.6, 0.8, 1.2),
			cframe = CFrame.new(),
			color = Color3.fromRGB(220, 80, 60),
			canCollide = false,
		})
		for _, side in { -1, 1 } do
			makePart({
				name = "Claw",
				size = Vector3.new(0.5, 0.5, 0.7),
				cframe = CFrame.new(side * 1, 0, -0.6),
				color = Color3.fromRGB(240, 100, 80),
				canCollide = false,
			}).Parent =
				model
		end
	elseif petId == "Parrot" then
		body = makePart({
			name = "Body",
			size = Vector3.new(0.9, 1.1, 1.2),
			cframe = CFrame.new(),
			color = Color3.fromRGB(60, 170, 80),
			canCollide = false,
		})
		makePart({
			name = "Head",
			size = Vector3.new(0.7, 0.7, 0.7),
			cframe = CFrame.new(0, 0.8, -0.3),
			color = Color3.fromRGB(220, 70, 70),
			shape = "Ball",
			canCollide = false,
		}).Parent =
			model
	else -- Seagull (default)
		body = makePart({
			name = "Body",
			size = Vector3.new(0.9, 0.9, 1.4),
			cframe = CFrame.new(),
			color = Color3.fromRGB(240, 240, 245),
			shape = "Ball",
			canCollide = false,
		})
		for _, side in { -1, 1 } do
			makePart({
				name = "Wing",
				size = Vector3.new(1.2, 0.15, 0.7),
				cframe = CFrame.new(side * 0.9, 0.2, 0),
				color = Color3.fromRGB(210, 210, 220),
				canCollide = false,
			}).Parent =
				model
		end
		makePart({
			name = "Beak",
			size = Vector3.new(0.25, 0.2, 0.5),
			cframe = CFrame.new(0, 0.1, -0.9),
			color = Color3.fromRGB(240, 170, 60),
			canCollide = false,
		}).Parent =
			model
	end
	body.Parent = model
	model.PrimaryPart = body
	return model
end

--------------------------------------------------------------------------------
-- Race crabs (anchored; CrabRacing PivotTo's them along the track)
--------------------------------------------------------------------------------

function ModelFactory.buildCrab(color: Color3): Model
	local model = Instance.new("Model")
	model.Name = "RaceCrab"
	local body = makePart({
		name = "Body",
		size = Vector3.new(2.2, 1, 1.6),
		cframe = CFrame.new(),
		color = color,
		canCollide = false,
	})
	body.Parent = model
	model.PrimaryPart = body
	for _, side in { -1, 1 } do
		makePart({
			name = "Claw",
			size = Vector3.new(0.7, 0.7, 0.9),
			cframe = CFrame.new(side * 1.4, 0, -0.8),
			color = color:Lerp(Color3.new(1, 1, 1), 0.2),
			canCollide = false,
		}).Parent =
			model
		for legIndex = 1, 3 do
			makePart({
				name = "Leg",
				size = Vector3.new(0.25, 0.8, 0.25),
				cframe = CFrame.new(side * 1.3, -0.5, -0.6 + legIndex * 0.5),
				color = color,
				canCollide = false,
			}).Parent =
				model
		end
	end
	for _, side in { -1, 1 } do
		makePart({
			name = "Eye",
			size = Vector3.new(0.25, 0.4, 0.25),
			cframe = CFrame.new(side * 0.4, 0.7, -0.7),
			color = Color3.fromRGB(20, 20, 20),
			canCollide = false,
		}).Parent =
			model
	end
	return model
end

--------------------------------------------------------------------------------
-- Buoys (zone boundary markers)
--------------------------------------------------------------------------------

function ModelFactory.buildBuoy(color: Color3, position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Buoy"
	local float = makePart({
		name = "Float",
		size = Vector3.new(3, 3, 3),
		cframe = CFrame.new(position.X, 1, position.Z),
		color = color,
		shape = "Ball",
	})
	float.Parent = model
	model.PrimaryPart = float
	local pole = makePart({
		name = "Pole",
		size = Vector3.new(0.4, 5, 0.4),
		cframe = CFrame.new(position.X, 4, position.Z),
		color = Color3.fromRGB(220, 220, 220),
	})
	pole.Parent = model
	local light = makePart({
		name = "Lamp",
		size = Vector3.new(0.9, 0.9, 0.9),
		cframe = CFrame.new(position.X, 6.8, position.Z),
		color = color,
		material = Enum.Material.Neon,
		shape = "Ball",
	})
	light.Parent = model
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = 24
	pointLight.Parent = light
	return model
end

return ModelFactory
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source">--!strict
-- Robux entry points: Pearl developer products and the premium battle pass
-- game pass. Receipts are made idempotent by recording PurchaseId in the
-- profile before granting — a re-delivered receipt is acknowledged, not
-- re-granted (classic dupe protection).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

local function pearlsForProduct(productId: number): number?
	for _, product in MonetizationConfig.PearlProducts do
		if product.productId == productId and product.productId ~= 0 then
			return product.pearls
		end
	end
	return nil
end

local function processReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		-- Player left; Roblox will re-deliver this receipt on next join.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Idempotency: already granted? Just acknowledge.
	if data.redeemedReceipts[receiptInfo.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local pearls = pearlsForProduct(receiptInfo.ProductId)
	if not pearls then
		warn(`[Monetization] Receipt for unknown product {receiptInfo.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Record BEFORE granting so a crash between the two never double-grants
	-- (worst case the player is owed pearls we can reconcile from receipts).
	data.redeemedReceipts[receiptInfo.PurchaseId] = true
	DataService.adjustPearls(player, pearls)
	Remotes.getEvent("Notify"):FireClient(player, `+{pearls} Pearls — thank you!`, "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Premium battle pass ownership check, refreshed on join.
local function refreshGamePasses(player: Player)
	local passId = MonetizationConfig.PremiumBattlePassGamePassId
	if passId == 0 then
		return -- not configured yet
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	if ok and owns then
		local data = DataService.get(player)
		if data and not data.battlePass.ownsPremium then
			data.battlePass.ownsPremium = true
			DataService.replicate(player, { "battlePass" })
		end
	end
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			-- Wait for the profile, then sync game pass ownership.
			local deadline = os.clock() + 30
			while os.clock() &lt; deadline and player.Parent do
				if DataService.get(player) then
					refreshGamePasses(player)
					return
				end
				task.wait(0.5)
			end
		end)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == MonetizationConfig.PremiumBattlePassGamePassId then
			refreshGamePasses(player)
		end
	end)
end

return MonetizationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">PetService</string><ProtectedString name="Source">--!strict
-- Spawns/despawns the equipped cosmetic pet and makes it bob along behind the
-- player's shoulder. Purely visual — the pet's tiny luck/sell bonuses are read
-- directly from data by Fishing/Market services, never from the model.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)
local ModelFactory = require(script.Parent.ModelFactory)

local PetService = {}

local pets: { [Player]: { petId: string, model: Model } } = {}

local function syncPet(player: Player)
	local data = DataService.get(player)
	local wantedId = data and data.cosmetics.equipped.pet or nil
	local current = pets[player]
	if current and current.petId == wantedId then
		return
	end
	if current then
		current.model:Destroy()
		pets[player] = nil
	end
	if wantedId then
		local model = ModelFactory.buildPet(wantedId)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		model:PivotTo(CFrame.new((root and root.Position or Vector3.zero) + Vector3.new(2, 3, 2)))
		model.Parent = workspace
		pets[player] = { petId = wantedId, model = model }
	end
end

local function followStep(deltaTime: number)
	local now = os.clock()
	for player, pet in pets do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or not pet.model.Parent then
			continue
		end
		-- Hover behind-right of the shoulder with a gentle sine bob.
		local bob = math.sin(now * 3 + player.UserId % 10) * 0.4
		local target = root.CFrame * CFrame.new(2.5, 2 + bob, 2.5)
		local current = pet.model:GetPivot()
		pet.model:PivotTo(current:Lerp(target, math.min(deltaTime * 6, 1)))
	end
end

function PetService.init()
	-- Equip changes flow through DataService.replicate("cosmetics"); polling
	-- once a second keeps this decoupled from EconomyService internals.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				syncPet(player)
			end
		end
	end)
	RunService.Heartbeat:Connect(followStep)
	Players.PlayerRemoving:Connect(function(player)
		local pet = pets[player]
		pets[player] = nil
		if pet then
			pet.model:Destroy()
		end
	end)
end

return PetService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">WorldService</string><ProtectedString name="Source">--!strict
-- Builds the world at server start so the game is fully playable (and
-- swimmable) with zero uploaded assets:
--   * Real Terrain water across all zones (deep pit under the Deep Trench)
--   * Sand seafloors, a beach island behind the spawn dock
--   * Wooden spawn dock with pilings + SpawnLocation
--   * Dockmaster / market NPC characters (procedural) with ProximityPrompts
--   * Mini-game station platforms with NPCs
--   * Sunken wreck at the Treasure Diving site
--   * Lit buoys marking zone boundaries (green = tier-1 accessible, red = gated)
-- Everything is tagged with the "Greybox" attribute; replace piecemeal with
-- real art whenever — game logic only depends on prompt attributes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local MiniGameConfig = require(Shared.Config.MiniGameConfig)

local ModelFactory = require(script.Parent.ModelFactory)

local WorldService = {}

local WORLD = GameConfig.WORLD

local function tag(instance: Instance): Instance
	instance:SetAttribute("Greybox", true)
	return instance
end

local function anchoredPart(props: {
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
}): Part
	local part = Instance.new("Part")
	part.Name = props.name
	part.Size = props.size
	part.CFrame = props.cframe
	part.Color = props.color or Color3.fromRGB(128, 128, 128)
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.CanCollide = props.canCollide ~= false
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	tag(part)
	part.Parent = workspace
	return part
end

--------------------------------------------------------------------------------
-- Terrain
--------------------------------------------------------------------------------

local function buildTerrain()
	local terrain = workspace.Terrain

	-- One contiguous water sheet over the whole play space (surface at Y=0)
	-- so boats never cross dry gaps between zone rectangles.
	terrain:FillBlock(CFrame.new(1400, -15, 500), Vector3.new(3800, 30, 2800), Enum.Material.Water)

	-- Deep pit under the Deep Trench zone.
	local trench = ZoneConfig.Layout.DeepTrench
	terrain:FillBlock(
		CFrame.new(trench.center.X, -110, trench.center.Z),
		Vector3.new(trench.size.X, 220, trench.size.Z),
		Enum.Material.Water
	)

	-- Seafloors (filled after water so they replace the bottom voxels).
	local floors: { [string]: Enum.Material } = {
		StarterBay = Enum.Material.Sand,
		OpenOcean = Enum.Material.Sandstone,
		StormZone = Enum.Material.Slate,
	}
	for zoneId, material in floors do
		local bounds = ZoneConfig.Layout[zoneId]
		terrain:FillBlock(
			CFrame.new(bounds.center.X, -32, bounds.center.Z),
			Vector3.new(bounds.size.X + 128, 12, bounds.size.Z + 128),
			material
		)
	end
	terrain:FillBlock(
		CFrame.new(trench.center.X, -226, trench.center.Z),
		Vector3.new(trench.size.X, 16, trench.size.Z),
		Enum.Material.Rock
	)

	-- Beach island behind the spawn dock (rises above the waterline).
	terrain:FillBlock(CFrame.new(0, -2, -190), Vector3.new(240, 26, 140), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(0, 6, -230), Vector3.new(140, 10, 60), Enum.Material.Grass)
end

--------------------------------------------------------------------------------
-- Docks &amp; NPCs
--------------------------------------------------------------------------------

-- NPC with billboard + prompt. The prompt's UIAction attribute is the entire
-- client integration contract (UIController routes it to a modal).
local function npcCharacter(name: string, label: string, position: Vector3, outfitColor: Color3, promptAction: string)
	local npc = ModelFactory.buildNPC(name, outfitColor, position - Vector3.new(0, 5, 0), math.pi)
	tag(npc)
	npc.Parent = workspace
	local torso = npc.PrimaryPart :: BasePart

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(200, 50)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = label
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.4
	text.TextScaled = true
	text.Font = Enum.Font.GothamBold
	text.Parent = billboard
	billboard.Parent = torso

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = label
	prompt.ObjectText = name
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("UIAction", promptAction)
	prompt.Parent = torso
end

local function woodPlatform(name: string, center: Vector3, size: Vector3)
	anchoredPart({
		name = name,
		size = size,
		cframe = CFrame.new(center),
		color = Color3.fromRGB(150, 115, 75),
		material = Enum.Material.WoodPlanks,
	})
	-- Pilings down into the water at the corners.
	local half = size / 2
	for _, corner in { Vector2.new(1, 1), Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(-1, -1) } do
		anchoredPart({
			name = name .. "Piling",
			size = Vector3.new(1.2, center.Y + 30, 1.2),
			cframe = CFrame.new(
				center.X + (half.X - 1.5) * corner.X,
				(center.Y - 30) / 2 + 12,
				center.Z + (half.Z - 1.5) * corner.Y
			),
			color = Color3.fromRGB(100, 75, 50),
			material = Enum.Material.Wood,
		})
	end
end

local function buildSpawnDock()
	woodPlatform("SpawnDock", Vector3.new(0, 3, -80), Vector3.new(120, 2, 80))

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.Position = Vector3.new(0, 4.5, -100)
	spawnLocation.Anchored = true
	spawnLocation.Neutral = true
	spawnLocation.Color = Color3.fromRGB(170, 140, 95)
	spawnLocation.Material = Enum.Material.WoodPlanks
	tag(spawnLocation)
	spawnLocation.Parent = workspace

	npcCharacter("Dockmaster", "Upgrade Boat", WORLD.DOCKMASTER_POSITION, Color3.fromRGB(200, 140, 60), "UpgradeShop")
	npcCharacter("Fishmonger", "Sell Fish &amp; Shop", WORLD.MARKET_POSITION, Color3.fromRGB(80, 170, 90), "Market")
end

local function buildStations()
	for gameId, entry in MiniGameConfig.Games do
		local center = entry.stationPosition
		woodPlatform(`Station_{gameId}`, Vector3.new(center.X, 2.5, center.Z), Vector3.new(20, 2, 20))
		npcCharacter(
			`Host_{gameId}`,
			entry.displayName,
			Vector3.new(center.X, 5, center.Z),
			if entry.enabled then Color3.fromRGB(90, 120, 220) else Color3.fromRGB(90, 90, 100),
			`MiniGame:{gameId}`
		)
	end
end

--------------------------------------------------------------------------------
-- Wreck (Treasure Diving site) &amp; buoys
--------------------------------------------------------------------------------

local function buildWreck()
	local site = WORLD.DIVE_SITE
	local woodColor = Color3.fromRGB(70, 55, 40)
	-- A broken hull: two tilted halves + a snapped mast, resting on the bay floor.
	anchoredPart({
		name = "WreckHullFore",
		size = Vector3.new(8, 5, 14),
		cframe = CFrame.new(site + Vector3.new(-4, 1, -6)) * CFrame.Angles(math.rad(12), math.rad(20), math.rad(-8)),
		color = woodColor,
		material = Enum.Material.WoodPlanks,
	})
	anchoredPart({
		name = "WreckHullAft",
		size = Vector3.new(8, 5, 10),
		cframe = CFrame.new(site + Vector3.new(6, 0.5, 8)) * CFrame.Angles(math.rad(-8), math.rad(-30), math.rad(14)),
		color = woodColor,
		material = Enum.Material.WoodPlanks,
	})
	anchoredPart({
		name = "WreckMast",
		size = Vector3.new(1, 18, 1),
		cframe = CFrame.new(site + Vector3.new(0, 2, 2)) * CFrame.Angles(0, 0, math.rad(75)),
		color = Color3.fromRGB(60, 48, 36),
		material = Enum.Material.Wood,
	})
end

local function buildBuoys()
	for zoneId, bounds in ZoneConfig.Layout do
		local zone = ZoneConfig.getZone(zoneId)
		local color = if zone and zone.requiredBoatTier &gt; 1
			then Color3.fromRGB(230, 80, 70)
			else Color3.fromRGB(70, 210, 110)
		local half = bounds.size / 2
		-- Corners + edge midpoints so boundaries read at sea level.
		local offsets = {
			Vector2.new(1, 1),
			Vector2.new(-1, 1),
			Vector2.new(1, -1),
			Vector2.new(-1, -1),
			Vector2.new(1, 0),
			Vector2.new(-1, 0),
			Vector2.new(0, 1),
			Vector2.new(0, -1),
		}
		for _, offset in offsets do
			local buoy = ModelFactory.buildBuoy(
				color,
				Vector3.new(bounds.center.X + half.X * offset.X, 0, bounds.center.Z + half.Z * offset.Y)
			)
			tag(buoy)
			buoy.Parent = workspace
		end
	end
end

--------------------------------------------------------------------------------

function WorldService.init()
	buildTerrain()
	buildSpawnDock()
	buildStations()
	buildWreck()
	buildBuoys()
end

return WorldService
</ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX32"><Properties><string name="Name">Server</string><ProtectedString name="Source">--!strict
-- Server bootstrap. Order matters:
--   1. Remotes first (clients wait on the folder)
--   2. DataService before anything that reads profiles
--   3. Everything else in dependency order
-- Each service exposes a single init(); services talk to each other via
-- require, never via _G or globals.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Services = script.Parent.Services

Remotes.init()

local DataService = require(Services.DataService)
local BattlePassService = require(Services.BattlePassService)
local MarketService = require(Services.MarketService)
local BoatService = require(Services.BoatService)
local EconomyService = require(Services.EconomyService)
local FishingService = require(Services.FishingService)
local MiniGameManager = require(Services.MiniGameManager)
local MonetizationService = require(Services.MonetizationService)
local PetService = require(Services.PetService)
local WorldService = require(Services.WorldService)

DataService.init()
BattlePassService.init()
MarketService.init()
BoatService.init()
EconomyService.init()
FishingService.init()
MiniGameManager.init()
MonetizationService.init()
PetService.init()
WorldService.init()

print("[CruiseTycoon] Server initialized")
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX55"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX54"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX50"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX39"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">AmbienceController</string><ProtectedString name="Source">--!strict
-- Per-zone atmosphere, all procedural (no audio/image assets):
--   * Lighting fog/ambient tweens per zone
--   * Rain particles + lightning flashes in the Storm Zone
--   * Heavy dark fog in the Deep Trench
-- Swap in real skyboxes/audio during an art pass; this keeps zones readable.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ZoneConfig = require(Shared.Config.ZoneConfig)

local AmbienceController = {}

local player = Players.LocalPlayer

type Preset = {
	fogColor: Color3,
	fogEnd: number,
	outdoorAmbient: Color3,
	brightness: number,
}

local PRESETS: { [string]: Preset } = {
	Default = {
		fogColor = Color3.fromRGB(190, 210, 230),
		fogEnd = 5000,
		outdoorAmbient = Color3.fromRGB(128, 128, 128),
		brightness = 2,
	},
	StarterBay = {
		fogColor = Color3.fromRGB(200, 220, 235),
		fogEnd = 4000,
		outdoorAmbient = Color3.fromRGB(140, 140, 135),
		brightness = 2.2,
	},
	OpenOcean = {
		fogColor = Color3.fromRGB(180, 200, 220),
		fogEnd = 2500,
		outdoorAmbient = Color3.fromRGB(120, 125, 135),
		brightness = 2,
	},
	StormZone = {
		fogColor = Color3.fromRGB(90, 95, 105),
		fogEnd = 500,
		outdoorAmbient = Color3.fromRGB(60, 62, 70),
		brightness = 0.8,
	},
	DeepTrench = {
		fogColor = Color3.fromRGB(15, 25, 45),
		fogEnd = 300,
		outdoorAmbient = Color3.fromRGB(40, 50, 75),
		brightness = 0.6,
	},
}

local currentPreset = "Default"
local rainEmitter: ParticleEmitter
local rainAnchor: Part

local function applyPreset(name: string)
	if name == currentPreset then
		return
	end
	currentPreset = name
	local preset = PRESETS[name] or PRESETS.Default
	TweenService:Create(Lighting, TweenInfo.new(2), {
		FogColor = preset.fogColor,
		FogEnd = preset.fogEnd,
		OutdoorAmbient = preset.outdoorAmbient,
		Brightness = preset.brightness,
	}):Play()
	rainEmitter.Enabled = name == "StormZone"
end

-- Occasional lightning while in the Storm Zone: quick exposure spike.
local function lightningLoop()
	while true do
		task.wait(4 + math.random() * 8)
		if currentPreset == "StormZone" then
			local original = Lighting.ExposureCompensation
			Lighting.ExposureCompensation = original + 1.5
			task.wait(0.08)
			Lighting.ExposureCompensation = original + 0.6
			task.wait(0.05)
			Lighting.ExposureCompensation = original
		end
	end
end

function AmbienceController.init()
	-- Invisible anchor above the camera carries the rain emitter.
	rainAnchor = Instance.new("Part")
	rainAnchor.Name = "RainAnchor"
	rainAnchor.Size = Vector3.new(90, 1, 90)
	rainAnchor.Transparency = 1
	rainAnchor.Anchored = true
	rainAnchor.CanCollide = false
	rainAnchor.CanQuery = false
	rainAnchor.Parent = workspace

	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Name = "Rain"
	rainEmitter.Enabled = false
	rainEmitter.Rate = 900
	rainEmitter.Lifetime = NumberRange.new(0.8, 1.1)
	rainEmitter.Speed = NumberRange.new(60, 70)
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.Size = NumberSequence.new(0.12)
	rainEmitter.Transparency = NumberSequence.new(0.35)
	rainEmitter.Color = ColorSequence.new(Color3.fromRGB(190, 210, 235))
	rainEmitter.Parent = rainAnchor

	-- Follow the camera; check the zone once a second.
	RunService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera
		if camera then
			rainAnchor.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 45, 0))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local zoneId = ZoneConfig.zoneAtPosition(root.Position)
				applyPreset(zoneId or "Default")
			end
		end
	end)
	task.spawn(lightningLoop)
end

return AmbienceController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">ClientData</string><ProtectedString name="Source">--!strict
-- Client-side replica of the player's PlayerData.
-- Boots from GetData, then merges DataChanged partial snapshots. UI reads
-- ClientData.get() and subscribes to Changed — never talks to remotes for data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientData = {}

local data: any = nil
local changedEvent = Instance.new("BindableEvent")

-- Fired with the set of top-level keys that changed.
ClientData.Changed = changedEvent.Event

function ClientData.get(): any
	return data
end

-- Convenience: waits until the initial snapshot has arrived.
function ClientData.await(): any
	while data == nil do
		task.wait(0.1)
	end
	return data
end

function ClientData.init()
	Remotes.getEvent("DataChanged").OnClientEvent:Connect(function(snapshot: { [string]: any })
		if data == nil then
			data = snapshot
		else
			for key, value in snapshot do
				data[key] = value
			end
		end
		local keys = {}
		for key in snapshot do
			table.insert(keys, key)
		end
		changedEvent:Fire(keys)
	end)

	task.spawn(function()
		local snapshot = Remotes.getFunction("GetData"):InvokeServer()
		-- A DataChanged may have raced us with fresher info; only fill gaps.
		if snapshot then
			if data == nil then
				data = snapshot
			else
				for key, value in snapshot do
					if data[key] == nil then
						data[key] = value
					end
				end
			end
			changedEvent:Fire({ "all" })
		end
	end)
end

return ClientData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">FishingController</string><ProtectedString name="Source">--!strict
-- Client fishing loop: cast button -&gt; wait -&gt; reel timing-bar minigame.
--
-- The reel minigame: a marker sweeps left-right across a bar; a "sweet spot"
-- band (width from the server's BiteAlert, i.e. rod tier) sits at a random
-- position. Tap/click to stop the marker; accuracy = how close to the band's
-- center you stopped (0 outside the band). Accuracy goes to the server, which
-- clamps it and only uses it for weight bias + escape chance — so this stays
-- a skill garnish, not a trust point.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local FishConfig = require(Shared.Config.FishConfig)
local Format = require(Shared.Util.Format)

local Theme = require(script.Parent.Parent.UI.Theme)

local FishingController = {}

type Phase = "Idle" | "Waiting" | "Reeling"
local phase: Phase = "Idle"

-- UI refs built once in init()
local screenGui: ScreenGui
local castButton: TextButton
local reelFrame: Frame
local marker: Frame
local sweetSpot: Frame
local statusLabel: TextLabel

local reelConnection: RBXScriptConnection? = nil

local function setStatus(text: string, seconds: number?)
	statusLabel.Text = text
	statusLabel.Visible = text ~= ""
	if seconds then
		task.delay(seconds, function()
			if statusLabel.Text == text then
				statusLabel.Visible = false
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Reel minigame
--------------------------------------------------------------------------------

local function stopReel(accuracy: number)
	if reelConnection then
		reelConnection:Disconnect()
		reelConnection = nil
	end
	reelFrame.Visible = false
	phase = "Idle"
	castButton.Text = "CAST"
	Remotes.getEvent("ReelResult"):FireServer(accuracy)
end

local function startReel(params: { sweetSpotSize: number, timeLimit: number })
	phase = "Reeling"
	reelFrame.Visible = true
	castButton.Text = "REEL!"

	-- Random band position; width from rod tier (server-provided).
	local bandWidth = math.clamp(params.sweetSpotSize, 0.05, 0.6)
	local bandCenter = bandWidth / 2 + math.random() * (1 - bandWidth)
	sweetSpot.Size = UDim2.fromScale(bandWidth, 1)
	sweetSpot.Position = UDim2.fromScale(bandCenter - bandWidth / 2, 0)

	local startedAt = os.clock()
	local sweepSpeed = 0.9 -- full-bar sweeps per second; ping-pongs
	reelConnection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startedAt
		if elapsed &gt; params.timeLimit then
			stopReel(0) -- ran out the clock: guaranteed escape
			return
		end
		-- Triangle wave 0..1..0
		local cycle = (elapsed * sweepSpeed) % 2
		local markerPosition = if cycle &lt;= 1 then cycle else 2 - cycle
		marker.Position = UDim2.fromScale(markerPosition, 0)
		marker:SetAttribute("Pos", markerPosition)
	end)
end

local function onReelTap()
	local markerPosition = marker:GetAttribute("Pos") :: number? or 0
	local bandWidth = sweetSpot.Size.X.Scale
	local bandCenter = sweetSpot.Position.X.Scale + bandWidth / 2
	local distance = math.abs(markerPosition - bandCenter)
	-- 1.0 dead-center, tapering to 0 at the band edge; 0 outside.
	local accuracy = if distance &lt;= bandWidth / 2 then 1 - (distance / (bandWidth / 2)) * 0.6 else 0
	stopReel(accuracy)
end

--------------------------------------------------------------------------------
-- Cast flow
--------------------------------------------------------------------------------

local function onCastTap()
	if phase == "Idle" then
		phase = "Waiting"
		castButton.Text = "WAITING..."
		setStatus("Line cast. Watch for a bite!", 2)
		Remotes.getEvent("CastRequest"):FireServer()
		-- The server may silently reject (cooldown/zone/full hold); Notify
		-- handles messaging, we just need to not get stuck visually.
		task.delay(15, function()
			if phase == "Waiting" then
				phase = "Idle"
				castButton.Text = "CAST"
			end
		end)
	elseif phase == "Waiting" then
		phase = "Idle"
		castButton.Text = "CAST"
		Remotes.getEvent("CancelCast"):FireServer()
	elseif phase == "Reeling" then
		onReelTap()
	end
end

--------------------------------------------------------------------------------

function FishingController.init(parentGui: ScreenGui)
	screenGui = parentGui

	-- Cast/reel mega-button: bottom-center, thumb-reachable on phones.
	castButton = Instance.new("TextButton")
	castButton.Name = "CastButton"
	castButton.AnchorPoint = Vector2.new(0.5, 1)
	castButton.Position = UDim2.new(0.5, 0, 1, -24)
	castButton.Size = UDim2.fromOffset(160, 64)
	castButton.BackgroundColor3 = Theme.Colors.Accent
	castButton.Text = "CAST"
	castButton.TextColor3 = Theme.Colors.Text
	castButton.Font = Theme.FontBold
	castButton.TextSize = 24
	Theme.corner(castButton, 16)
	castButton.Activated:Connect(onCastTap)
	castButton.Parent = screenGui

	-- Reel bar sits above the button.
	reelFrame = Instance.new("Frame")
	reelFrame.Name = "ReelBar"
	reelFrame.AnchorPoint = Vector2.new(0.5, 1)
	reelFrame.Position = UDim2.new(0.5, 0, 1, -104)
	reelFrame.Size = UDim2.new(0.8, 0, 0, 36)
	reelFrame.BackgroundColor3 = Theme.Colors.Panel
	reelFrame.Visible = false
	local maxWidth = Instance.new("UISizeConstraint")
	maxWidth.MaxSize = Vector2.new(480, 36)
	maxWidth.Parent = reelFrame
	Theme.corner(reelFrame)
	reelFrame.Parent = screenGui

	sweetSpot = Instance.new("Frame")
	sweetSpot.Name = "SweetSpot"
	sweetSpot.BackgroundColor3 = Theme.Colors.Success
	sweetSpot.BackgroundTransparency = 0.25
	sweetSpot.BorderSizePixel = 0
	Theme.corner(sweetSpot, 6)
	sweetSpot.Parent = reelFrame

	marker = Instance.new("Frame")
	marker.Name = "Marker"
	marker.Size = UDim2.new(0, 6, 1, 0)
	marker.BackgroundColor3 = Theme.Colors.Gold
	marker.BorderSizePixel = 0
	marker.ZIndex = 2
	marker.Parent = reelFrame

	statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "FishingStatus"
	statusLabel.AnchorPoint = Vector2.new(0.5, 1)
	statusLabel.Position = UDim2.new(0.5, 0, 1, -152)
	statusLabel.Size = UDim2.new(0.8, 0, 0, 28)
	statusLabel.BackgroundTransparency = 1
	statusLabel.TextColor3 = Theme.Colors.Text
	statusLabel.TextStrokeTransparency = 0.4
	statusLabel.Font = Theme.FontBold
	statusLabel.TextScaled = true
	statusLabel.Visible = false
	statusLabel.Parent = screenGui

	-- Server events
	Remotes.getEvent("BiteAlert").OnClientEvent:Connect(function(params)
		if phase ~= "Waiting" then
			return
		end
		setStatus("BITE! Tap in the green zone!", 2)
		startReel(params)
	end)

	Remotes.getEvent("CatchResult").OnClientEvent:Connect(function(catch, escaped)
		if reelConnection then -- server auto-failed us (timeout)
			stopReel(0)
		end
		phase = "Idle"
		castButton.Text = "CAST"
		if escaped or not catch then
			setStatus("It got away...", 2)
			return
		end
		local def = FishConfig.getFish(catch.fishId)
		if def then
			local rarityColor = FishConfig.RARITY_INFO[def.rarity].color
			statusLabel.TextColor3 = rarityColor
			setStatus(`Caught a {def.rarity} {def.displayName} ({Format.weight(catch.weight)})!`, 3)
			task.delay(3, function()
				statusLabel.TextColor3 = Theme.Colors.Text
			end)
		end
	end)

	-- Desktop convenience: Space casts/reels too.
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space and phase == "Reeling" then
			onReelTap()
		end
	end)
end

return FishingController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">MinimapController</string><ProtectedString name="Source">--!strict
-- Procedural minimap (no image assets): zone rectangles drawn to scale from
-- ZoneConfig.Layout, landmark dots from GameConfig.WORLD / MiniGameConfig,
-- and a live player arrow. Locked zones show red until the boat tier allows
-- them (updates live from ClientData).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local MiniGameConfig = require(Shared.Config.MiniGameConfig)

local ClientData = require(script.Parent.ClientData)
local Theme = require(script.Parent.Parent.UI.Theme)

local MinimapController = {}

local player = Players.LocalPlayer

local MAP_SIZE = 150 -- px, square

-- World bounds = union of zone rectangles plus a margin.
local minX, maxX = math.huge, -math.huge
local minZ, maxZ = math.huge, -math.huge
for _, bounds in ZoneConfig.Layout do
	local half = bounds.size / 2
	minX = math.min(minX, bounds.center.X - half.X)
	maxX = math.max(maxX, bounds.center.X + half.X)
	minZ = math.min(minZ, bounds.center.Z - half.Z)
	maxZ = math.max(maxZ, bounds.center.Z + half.Z)
end
local MARGIN = 100
minX -= MARGIN
maxX += MARGIN
minZ -= MARGIN
maxZ += MARGIN

local function toMap(worldPosition: Vector3): UDim2
	local u = (worldPosition.X - minX) / (maxX - minX)
	local v = (worldPosition.Z - minZ) / (maxZ - minZ)
	return UDim2.fromScale(u, v)
end

local zoneFrames: { [string]: Frame } = {}
local playerBlip: Frame

local function refreshZoneColors()
	local data = ClientData.get()
	local tier = data and data.boatTier or 1
	for zoneId, frame in zoneFrames do
		local zone = ZoneConfig.getZone(zoneId)
		if zone then
			frame.BackgroundColor3 = if tier &gt;= zone.requiredBoatTier
				then Color3.fromRGB(60, 130, 180)
				else Color3.fromRGB(150, 60, 60)
		end
	end
end

function MinimapController.init(parentGui: ScreenGui)
	local map = Instance.new("Frame")
	map.Name = "Minimap"
	map.AnchorPoint = Vector2.new(1, 0)
	map.Position = UDim2.new(1, -8, 0, 52)
	map.Size = UDim2.fromOffset(MAP_SIZE, MAP_SIZE)
	map.BackgroundColor3 = Color3.fromRGB(16, 36, 56) -- open sea
	map.BackgroundTransparency = 0.2
	map.ClipsDescendants = true
	Theme.corner(map, 10)
	map.Parent = parentGui

	-- Zone rectangles
	for zoneId, bounds in ZoneConfig.Layout do
		local frame = Instance.new("Frame")
		frame.Name = zoneId
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = toMap(bounds.center)
		frame.Size = UDim2.fromScale(bounds.size.X / (maxX - minX), bounds.size.Z / (maxZ - minZ))
		frame.BackgroundTransparency = 0.45
		frame.BorderSizePixel = 0
		Theme.corner(frame, 4)
		frame.Parent = map
		zoneFrames[zoneId] = frame

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 0.4)
		label.Position = UDim2.fromScale(0, 0.3)
		label.BackgroundTransparency = 1
		label.Text = ZoneConfig.getZone(zoneId).displayName
		label.TextColor3 = Color3.fromRGB(235, 240, 248)
		label.TextTransparency = 0.25
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.Parent = frame
	end

	-- Landmark dots: home dock (gold) + mini-game stations (blue).
	local landmarks: { { position: Vector3, color: Color3 } } = {
		{ position = GameConfig.WORLD.MARKET_POSITION, color = Color3.fromRGB(240, 195, 80) },
	}
	for _, entry in MiniGameConfig.Games do
		table.insert(landmarks, { position = entry.stationPosition, color = Color3.fromRGB(120, 170, 255) })
	end
	for _, landmark in landmarks do
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = toMap(landmark.position)
		dot.Size = UDim2.fromOffset(5, 5)
		dot.BackgroundColor3 = landmark.color
		dot.ZIndex = 3
		Theme.corner(dot, 3)
		dot.Parent = map
	end

	-- Player arrow (a rotated square reads fine at this size).
	playerBlip = Instance.new("Frame")
	playerBlip.AnchorPoint = Vector2.new(0.5, 0.5)
	playerBlip.Size = UDim2.fromOffset(8, 8)
	playerBlip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	playerBlip.ZIndex = 4
	Theme.corner(playerBlip, 2)
	playerBlip.Parent = map

	ClientData.Changed:Connect(refreshZoneColors)
	refreshZoneColors()

	-- 10 Hz is plenty for a minimap and cheap on mobile.
	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; 0.1 then
			return
		end
		accumulator = 0
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			playerBlip.Position = toMap(root.Position)
			local _, yaw, _ = root.CFrame:ToEulerAnglesYXZ()
			playerBlip.Rotation = -math.deg(yaw) + 45
		end
	end)
end

return MinimapController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">UIController</string><ProtectedString name="Source">--!strict
-- Owns the ScreenGui, the HUD, toast notifications, modal window management,
-- and routing of physical ProximityPrompts (dockmaster/market/mini-game
-- stations) to their screens. One modal open at a time.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local BoatConfig = require(Shared.Config.BoatConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.ClientData)
local Theme = require(script.Parent.Parent.UI.Theme)

local UIController = {}

local player = Players.LocalPlayer

local screenGui: ScreenGui
local currencyLabel: TextLabel
local pearlLabel: TextLabel
local boatLabel: TextLabel
local zoneLabel: TextLabel
local cargoLabel: TextLabel
local toastContainer: Frame

-- name -&gt; { open: () -&gt; (), close: () -&gt; () }
local modals: { [string]: { open: () -&gt; (), close: () -&gt; () } } = {}
local openModal: string? = nil

--------------------------------------------------------------------------------
-- Modal management
--------------------------------------------------------------------------------

function UIController.registerModal(name: string, handlers: { open: () -&gt; (), close: () -&gt; () })
	modals[name] = handlers
end

function UIController.open(name: string)
	if openModal == name then
		return
	end
	if openModal then
		modals[openModal].close()
	end
	local modal = modals[name]
	if modal then
		openModal = name
		modal.open()
	end
end

function UIController.close()
	if openModal then
		modals[openModal].close()
		openModal = nil
	end
end

function UIController.getGui(): ScreenGui
	return screenGui
end

--------------------------------------------------------------------------------
-- Toasts
--------------------------------------------------------------------------------

local KIND_COLORS = {
	info = Theme.Colors.Accent,
	success = Theme.Colors.Success,
	error = Theme.Colors.Danger,
}

function UIController.toast(message: string, kind: string?)
	local toast = Instance.new("TextLabel")
	toast.Size = UDim2.new(1, 0, 0, 36)
	toast.BackgroundColor3 = KIND_COLORS[kind or "info"] or Theme.Colors.Accent
	toast.BackgroundTransparency = 0.1
	toast.Text = message
	toast.TextColor3 = Theme.Colors.Text
	toast.Font = Theme.FontBold
	toast.TextScaled = true
	toast.TextWrapped = true
	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MaxTextSize = 16
	sizeConstraint.Parent = toast
	Theme.corner(toast)
	Theme.padding(toast, 6)
	toast.Parent = toastContainer

	task.delay(3.5, function()
		local tween =
			TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------------

local function hudChip(parent: Instance, order: number): (Frame, TextLabel)
	local chip = Instance.new("Frame")
	chip.Size = UDim2.fromOffset(120, 36)
	chip.BackgroundColor3 = Theme.Colors.Panel
	chip.BackgroundTransparency = 0.15
	chip.LayoutOrder = order
	Theme.corner(chip, 18)
	chip.Parent = parent
	local text = Theme.label({
		parent = chip,
		text = "",
		size = UDim2.fromScale(1, 1),
		bold = true,
		alignX = Enum.TextXAlignment.Center,
	})
	return chip, text
end

local function refreshHud()
	local data = ClientData.get()
	if not data then
		return
	end
	currencyLabel.Text = `🪙 {Format.abbreviate(data.doubloons)}`
	pearlLabel.Text = `⚪ {Format.abbreviate(data.pearls)}`
	local tierDef = BoatConfig.getTier(data.boatTier)
	boatLabel.Text = tierDef and `⛵ {tierDef.displayName}` or "⛵ ?"
	if tierDef then
		cargoLabel.Text = `🐟 {#data.fishInventory}/{tierDef.storage}`
	end
end

local function buildHud()
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.Position = UDim2.new(0, 8, 0, 8)
	topBar.Size = UDim2.new(1, -16, 0, 36)
	topBar.BackgroundTransparency = 1
	topBar.Parent = screenGui
	local layout = Theme.list(topBar, 8)
	layout.FillDirection = Enum.FillDirection.Horizontal

	local _, currencyText = hudChip(topBar, 1)
	currencyLabel = currencyText
	local _, pearlText = hudChip(topBar, 2)
	pearlLabel = pearlText
	local boatChip, boatText = hudChip(topBar, 3)
	boatChip.Size = UDim2.fromOffset(180, 36)
	boatLabel = boatText
	local _, cargoText = hudChip(topBar, 4)
	cargoLabel = cargoText

	-- Current zone indicator (simple minimap stand-in; a real minimap is a
	-- Studio/asset task — see README).
	zoneLabel = Theme.label({
		parent = screenGui,
		text = "",
		size = UDim2.new(0, 220, 0, 24),
		position = UDim2.new(0, 8, 0, 50),
		textColor = Theme.Colors.TextDim,
		bold = true,
	})
	task.spawn(function()
		while true do
			task.wait(1)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local zoneId = ZoneConfig.zoneAtPosition(root.Position)
				local zone = zoneId and ZoneConfig.getZone(zoneId)
				zoneLabel.Text = zone and `📍 {zone.displayName}` or "📍 Uncharted Waters"
			end
		end
	end)

	-- Side menu buttons (Dex, Battle Pass) — right edge, stacked, thumb-sized.
	local sideMenu = Instance.new("Frame")
	sideMenu.AnchorPoint = Vector2.new(1, 0.5)
	sideMenu.Position = UDim2.new(1, -8, 0.5, 0)
	sideMenu.Size = UDim2.fromOffset(56, 200)
	sideMenu.BackgroundTransparency = 1
	sideMenu.Parent = screenGui
	Theme.list(sideMenu, 10)

	local sideButtons = {
		{ icon = "📖", modal = "Dex", order = 1 },
		{ icon = "🏆", modal = "BattlePass", order = 2 },
	}
	for _, entry in sideButtons do
		local button = Instance.new("TextButton")
		button.Size = UDim2.fromOffset(56, 56)
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = 0.15
		button.Text = entry.icon
		button.TextSize = 28
		button.LayoutOrder = entry.order
		Theme.corner(button, 28)
		button.Activated:Connect(function()
			UIController.open(entry.modal)
		end)
		button.Parent = sideMenu
	end

	toastContainer = Instance.new("Frame")
	toastContainer.Name = "Toasts"
	toastContainer.AnchorPoint = Vector2.new(0.5, 0)
	toastContainer.Position = UDim2.new(0.5, 0, 0, 92)
	toastContainer.Size = UDim2.new(0.9, 0, 0, 200)
	toastContainer.BackgroundTransparency = 1
	local maxWidth = Instance.new("UISizeConstraint")
	maxWidth.MaxSize = Vector2.new(420, 200)
	maxWidth.Parent = toastContainer
	Theme.list(toastContainer, 6)
	toastContainer.Parent = screenGui
end

--------------------------------------------------------------------------------

function UIController.init()
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "CruiseTycoonUI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = false
	screenGui.Parent = player:WaitForChild("PlayerGui")

	buildHud()

	ClientData.Changed:Connect(refreshHud)
	refreshHud()

	Remotes.getEvent("Notify").OnClientEvent:Connect(function(message, kind)
		UIController.toast(tostring(message), kind)
	end)

	-- Physical interactions: prompts created by WorldService carry a UIAction
	-- attribute ("UpgradeShop" | "Market" | "MiniGame:&lt;id&gt;").
	ProximityPromptService.PromptTriggered:Connect(function(prompt, promptPlayer)
		if promptPlayer ~= player then
			return
		end
		local action = prompt:GetAttribute("UIAction")
		if typeof(action) ~= "string" then
			return
		end
		local miniGameId = string.match(action, "^MiniGame:(.+)$")
		if miniGameId then
			UIController.open(`MiniGame_{miniGameId}`)
		else
			UIController.open(action)
		end
	end)
end

return UIController
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX48"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">BattlePassUI</string><ProtectedString name="Source">--!strict
-- Battle pass screen: season header, XP progress, and the tier track with
-- claim buttons for free/premium rewards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local BattlePassConfig = require(Shared.Config.BattlePassConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.Parent.Controllers.ClientData)
local Theme = require(script.Parent.Theme)

local BattlePassUI = {}

local overlay: Frame
local content: ScrollingFrame
local uiController: any

local function describeReward(reward: any): string
	if not reward then
		return "—"
	end
	if reward.kind == "Doubloons" then
		return `{Format.comma(reward.amount or 0)} 🪙`
	elseif reward.kind == "Pearls" then
		return `{reward.amount or 0} ⚪`
	elseif reward.kind == "Bait" then
		return `{reward.amount or 1}x {reward.itemId} bait`
	end
	return `{reward.kind}: {reward.itemId}`
end

local function claim(tierIndex: number, premium: boolean)
	local result = Remotes.getFunction("ClaimBattlePassTier"):InvokeServer(tierIndex, premium)
	uiController.toast(
		if result.ok then "Reward claimed!" else (result.message or "Can't claim"),
		if result.ok then "success" else "error"
	)
end

local function rebuild()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local data = ClientData.get()
	if not data then
		return
	end
	local pass = data.battlePass

	Theme.label({
		parent = content,
		text = `Season {BattlePassConfig.SEASON.number}: {BattlePassConfig.SEASON.name}`,
		size = UDim2.new(1, 0, 0, 28),
		bold = true,
		textColor = Theme.Colors.Gold,
		layoutOrder = 0,
	})
	Theme.label({
		parent = content,
		text = `Your XP: {Format.comma(pass.xp)}` .. (pass.ownsPremium and "  •  PREMIUM ✓" or "  •  Free track"),
		size = UDim2.new(1, 0, 0, 22),
		layoutOrder = 1,
	})

	for tierIndex, tier in BattlePassConfig.Tiers do
		local unlocked = pass.xp &gt;= tier.xpRequired
		local row = Theme.rowCard(content, 96, 10 + tierIndex)
		if not unlocked then
			row.BackgroundTransparency = 0.4
		end
		Theme.label({
			parent = row,
			text = `Tier {tierIndex} — {Format.comma(tier.xpRequired)} XP` .. (unlocked and "" or " 🔒"),
			size = UDim2.new(1, 0, 0, 22),
			bold = true,
			textColor = if unlocked then Theme.Colors.Success else Theme.Colors.TextDim,
		})

		-- Free reward line + claim
		local freeClaimed = pass.claimedFree[tostring(tierIndex)] == true
		Theme.label({
			parent = row,
			text = `Free: {describeReward(tier.freeReward)}{freeClaimed and " ✓" or ""}`,
			size = UDim2.new(0.62, 0, 0, 20),
			position = UDim2.new(0, 0, 0, 26),
			textColor = Theme.Colors.Text,
		})
		if tier.freeReward and unlocked and not freeClaimed then
			Theme.button({
				parent = row,
				text = "Claim",
				size = UDim2.new(0.34, 0, 0, 28),
				position = UDim2.new(0.64, 0, 0, 22),
				color = Theme.Colors.Success,
				onClick = function()
					claim(tierIndex, false)
					rebuild()
				end,
			})
		end

		-- Premium reward line + claim
		local premiumClaimed = pass.claimedPremium[tostring(tierIndex)] == true
		Theme.label({
			parent = row,
			text = `Premium: {describeReward(tier.premiumReward)}{premiumClaimed and " ✓" or ""}`,
			size = UDim2.new(0.62, 0, 0, 20),
			position = UDim2.new(0, 0, 0, 52),
			textColor = Theme.Colors.Pearl,
		})
		if tier.premiumReward and unlocked and pass.ownsPremium and not premiumClaimed then
			Theme.button({
				parent = row,
				text = "Claim",
				size = UDim2.new(0.34, 0, 0, 28),
				position = UDim2.new(0.64, 0, 0, 52),
				color = Theme.Colors.Accent,
				onClick = function()
					claim(tierIndex, true)
					rebuild()
				end,
			})
		end
	end
end

function BattlePassUI.init(controller: any)
	uiController = controller
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "BattlePassModal",
		title = "🏆 Voyage Pass",
		onClose = controller.close,
	})
	controller.registerModal("BattlePass", {
		open = function()
			rebuild()
			overlay.Visible = true
		end,
		close = function()
			overlay.Visible = false
		end,
	})
end

return BattlePassUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">CrabRacingUI</string><ProtectedString name="Source">--!strict
-- Crab Racing screen: live race state (betting countdown, odds, progress
-- bars), bet placement, and payout results. Driven entirely by MiniGameState
-- broadcasts from the server module.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MiniGameConfig = require(Shared.Config.MiniGameConfig)

local Theme = require(script.Parent.Theme)

local CrabRacingUI = {}

local GAME_ID = "CrabRacing"

local overlay: Frame
local content: ScrollingFrame
local uiController: any
local isOpen = false

local phaseLabel: TextLabel
local crabRows: { { frame: Frame, nameLabel: TextLabel, progressFill: Frame, betButton: TextButton } } = {}
local resultLabel: TextLabel
local betAmount = 50 -- default stake; adjusted with +/- buttons
local betAmountLabel: TextLabel

local function placeBet(crabIndex: number)
	Remotes.getEvent("MiniGameAction"):FireServer(GAME_ID, "Bet", {
		crabIndex = crabIndex,
		amount = betAmount,
	})
end

local function buildLayout()
	local config = MiniGameConfig.Games.CrabRacing.config

	phaseLabel = Theme.label({
		parent = content,
		text = "Waiting for the next race...",
		size = UDim2.new(1, 0, 0, 28),
		bold = true,
		textColor = Theme.Colors.Gold,
		layoutOrder = 0,
	})

	-- Stake selector
	local stakeRow = Theme.rowCard(content, 52, 1)
	Theme.button({
		parent = stakeRow,
		text = "-",
		size = UDim2.fromOffset(44, 36),
		color = Theme.Colors.PanelLight,
		onClick = function()
			betAmount = math.max(config.minBet, betAmount - 50)
			betAmountLabel.Text = `Stake: {betAmount} 🪙`
		end,
	})
	betAmountLabel = Theme.label({
		parent = stakeRow,
		text = `Stake: {betAmount} 🪙`,
		size = UDim2.new(1, -110, 1, 0),
		position = UDim2.new(0, 52, 0, 0),
		bold = true,
		alignX = Enum.TextXAlignment.Center,
	})
	local plusButton = Theme.button({
		parent = stakeRow,
		text = "+",
		size = UDim2.fromOffset(44, 36),
		color = Theme.Colors.PanelLight,
		onClick = function()
			betAmount = math.min(config.maxBet, betAmount + 50)
			betAmountLabel.Text = `Stake: {betAmount} 🪙`
		end,
	})
	plusButton.AnchorPoint = Vector2.new(1, 0)
	plusButton.Position = UDim2.new(1, 0, 0, 0)

	-- Crab lanes
	for index = 1, config.crabCount do
		local row = Theme.rowCard(content, 72, 1 + index)
		local nameLabel = Theme.label({
			parent = row,
			text = `Crab {index}`,
			size = UDim2.new(1, 0, 0, 22),
			bold = true,
		})
		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, 0, 0, 12)
		track.Position = UDim2.new(0, 0, 0, 26)
		track.BackgroundColor3 = Theme.Colors.Background
		Theme.corner(track, 6)
		track.Parent = row
		local fill = Instance.new("Frame")
		fill.Size = UDim2.fromScale(0, 1)
		fill.BackgroundColor3 = Theme.Colors.Accent
		Theme.corner(fill, 6)
		fill.Parent = track
		local betButton = Theme.button({
			parent = row,
			text = "BET",
			size = UDim2.new(0.4, 0, 0, 26),
			position = UDim2.new(0.6, 0, 1, -26),
			color = Theme.Colors.Success,
			onClick = function()
				placeBet(index)
			end,
		})
		crabRows[index] = { frame = row, nameLabel = nameLabel, progressFill = fill, betButton = betButton }
	end

	resultLabel = Theme.label({
		parent = content,
		text = "",
		size = UDim2.new(1, 0, 0, 26),
		bold = true,
		alignX = Enum.TextXAlignment.Center,
		layoutOrder = 99,
	})
end

local function onState(state: any)
	if not isOpen then
		return
	end
	if state.error then
		uiController.toast(state.error, "error")
		return
	end
	if state.betPlaced then
		uiController.toast(`Bet {state.betPlaced.amount} 🪙 on {state.betPlaced.crabName}!`, "success")
		return
	end
	if state.personal then
		if state.personal.won then
			resultLabel.Text = `🎉 {state.personal.crabName} won — you got {state.personal.amount} 🪙!`
			resultLabel.TextColor3 = Theme.Colors.Success
		else
			resultLabel.Text = `{state.personal.crabName} won. Better luck next race!`
			resultLabel.TextColor3 = Theme.Colors.Danger
		end
		return
	end

	if state.phase == "Betting" then
		phaseLabel.Text = `🏁 Place your bets! {state.secondsLeft}s`
		resultLabel.Text = ""
	elseif state.phase == "Racing" then
		phaseLabel.Text = "🦀 They're off!"
	elseif state.phase == "Payout" and state.winnerName then
		phaseLabel.Text = `Winner: {state.winnerName}!`
	end

	for index, crab in state.crabs or {} do
		local row = crabRows[index]
		if row then
			row.nameLabel.Text = `{crab.name}  ({crab.odds}x)`
			row.progressFill.Size = UDim2.fromScale(crab.progress or 0, 1)
			row.betButton.Visible = state.phase == "Betting"
		end
	end
end

function CrabRacingUI.init(controller: any)
	uiController = controller
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "CrabRacingModal",
		title = "🦀 Crab Racing",
		onClose = controller.close,
	})
	buildLayout()
	controller.registerModal(`MiniGame_{GAME_ID}`, {
		open = function()
			isOpen = true
			overlay.Visible = true
		end,
		close = function()
			isOpen = false
			overlay.Visible = false
		end,
	})
	Remotes.getEvent("MiniGameState").OnClientEvent:Connect(function(gameId, state)
		if gameId == GAME_ID then
			onState(state)
		end
	end)
end

return CrabRacingUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">DexUI</string><ProtectedString name="Source">--!strict
-- Fish encyclopedia (Dex). Grouped by rarity, showing caught species with
-- stats and undiscovered ones as "???" silhouette rows.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FishConfig = require(Shared.Config.FishConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.Parent.Controllers.ClientData)
local Theme = require(script.Parent.Theme)

local DexUI = {}

local overlay: Frame
local content: ScrollingFrame

local function rebuild()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local data = ClientData.get()
	if not data then
		return
	end

	-- Completion header
	local totalSpecies = 0
	local caughtSpecies = 0
	for fishId in FishConfig.Fish do
		totalSpecies += 1
		if data.fishDex[fishId] then
			caughtSpecies += 1
		end
	end
	Theme.label({
		parent = content,
		text = `Discovered {caughtSpecies}/{totalSpecies} species`,
		size = UDim2.new(1, 0, 0, 28),
		bold = true,
		textColor = Theme.Colors.Gold,
		layoutOrder = 0,
	})

	local order = 1
	for rarityIndex, rarity in FishConfig.RARITY_ORDER do
		local rarityColor = FishConfig.RARITY_INFO[rarity].color
		Theme.label({
			parent = content,
			text = rarity,
			size = UDim2.new(1, 0, 0, 26),
			bold = true,
			textColor = rarityColor,
			layoutOrder = rarityIndex * 100,
		})
		order = rarityIndex * 100 + 1
		for fishId, def in FishConfig.Fish do
			if def.rarity ~= rarity then
				continue
			end
			local entry = data.fishDex[fishId]
			local row = Theme.rowCard(content, 64, order)
			order += 1
			if entry then
				Theme.label({
					parent = row,
					text = def.displayName,
					size = UDim2.new(1, 0, 0, 22),
					bold = true,
					textColor = rarityColor,
				})
				local zoneNames = {}
				for _, zoneId in def.zones do
					local zone = ZoneConfig.getZone(zoneId)
					table.insert(zoneNames, zone and zone.displayName or zoneId)
				end
				Theme.label({
					parent = row,
					text = `Caught {entry.caught} • Best {Format.weight(entry.bestWeight)} • {table.concat(
						zoneNames,
						", "
					)}`,
					size = UDim2.new(1, 0, 0, 18),
					position = UDim2.new(0, 0, 0, 24),
					textColor = Theme.Colors.TextDim,
				})
			else
				Theme.label({
					parent = row,
					text = "???",
					size = UDim2.new(1, 0, 0, 22),
					bold = true,
					textColor = Theme.Colors.TextDim,
				})
				Theme.label({
					parent = row,
					text = "Not yet discovered",
					size = UDim2.new(1, 0, 0, 18),
					position = UDim2.new(0, 0, 0, 24),
					textColor = Theme.Colors.TextDim,
				})
			end
		end
	end
end

function DexUI.init(controller: any)
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "DexModal",
		title = "📖 Fish Encyclopedia",
		onClose = controller.close,
	})
	controller.registerModal("Dex", {
		open = function()
			rebuild()
			overlay.Visible = true
		end,
		close = function()
			overlay.Visible = false
		end,
	})
end

return DexUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">MarketUI</string><ProtectedString name="Source">--!strict
-- Market dock screen: sell the hold, live demand readout, bait shop, rod
-- upgrades, and the Pearl cosmetics rack. Opened by the market NPC prompt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local GameConfig = require(Shared.Config.GameConfig)
local BaitConfig = require(Shared.Config.BaitConfig)
local FishConfig = require(Shared.Config.FishConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.Parent.Controllers.ClientData)
local Theme = require(script.Parent.Theme)

local MarketUI = {}

local overlay: Frame
local content: ScrollingFrame
local uiController: any

local function sectionHeader(text: string, order: number)
	Theme.label({
		parent = content,
		text = text,
		size = UDim2.new(1, 0, 0, 30),
		bold = true,
		textColor = Theme.Colors.Gold,
		layoutOrder = order,
	})
end

local function rebuild()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local data = ClientData.get()
	if not data then
		return
	end

	-- ===== Sell =====
	sectionHeader(`Your Hold ({#data.fishInventory} fish)`, 1)
	Theme.button({
		parent = content,
		text = "SELL ALL FISH",
		color = Theme.Colors.Success,
		layoutOrder = 2,
		onClick = function()
			local result = Remotes.getFunction("SellAllFish"):InvokeServer()
			uiController.toast(result.message or "...", if result.ok then "success" else "error")
			rebuild()
		end,
	})

	-- Demand ticker
	local prices = Remotes.getFunction("GetMarketPrices"):InvokeServer() or {}
	local demandRow = Theme.rowCard(content, 40, 3)
	local demandText = ""
	for _, rarity in FishConfig.RARITY_ORDER do
		local multiplier = prices[rarity]
		if multiplier then
			demandText ..= `{rarity} x{multiplier}  `
		end
	end
	Theme.label({
		parent = demandRow,
		text = "Demand: " .. demandText,
		size = UDim2.fromScale(1, 1),
		textColor = Theme.Colors.TextDim,
	})

	-- ===== Rod upgrade =====
	sectionHeader("Fishing Rod", 10)
	local currentRod = GameConfig.ROD_TIERS[data.rodTier]
	local nextRod = GameConfig.ROD_TIERS[data.rodTier + 1]
	local rodRow = Theme.rowCard(content, 72, 11)
	Theme.label({
		parent = rodRow,
		text = `{currentRod.name}` .. (nextRod and `  →  {nextRod.name}` or "  (MAX)"),
		size = UDim2.new(1, 0, 0.5, 0),
		bold = true,
	})
	if nextRod then
		Theme.button({
			parent = rodRow,
			text = `Upgrade — {Format.comma(nextRod.cost)} 🪙`,
			size = UDim2.new(1, 0, 0.5, -4),
			position = UDim2.new(0, 0, 0.5, 4),
			onClick = function()
				local result = Remotes.getFunction("UpgradeRod"):InvokeServer()
				uiController.toast(result.message or "Rod upgraded!", if result.ok then "success" else "error")
				rebuild()
			end,
		})
	end

	-- ===== Bait shop =====
	sectionHeader("Bait", 20)
	local order = 21
	for _, bait in BaitConfig.Baits do
		local owned = data.baitInventory[bait.id] or 0
		local isEquipped = data.equippedBait == bait.id
		local row = Theme.rowCard(content, 84, order)
		order += 1
		Theme.label({
			parent = row,
			text = `{bait.displayName} (own {owned}){isEquipped and " ✓ equipped" or ""}`,
			size = UDim2.new(1, 0, 0, 24),
			bold = true,
		})
		Theme.label({
			parent = row,
			text = bait.description,
			size = UDim2.new(1, 0, 0, 18),
			position = UDim2.new(0, 0, 0, 24),
			textColor = Theme.Colors.TextDim,
		})
		Theme.button({
			parent = row,
			text = `Buy 10 — {Format.comma(bait.cost * 10)} 🪙`,
			size = UDim2.new(0.48, 0, 0, 32),
			position = UDim2.new(0, 0, 1, -32),
			onClick = function()
				local result = Remotes.getFunction("BuyBait"):InvokeServer(bait.id, 10)
				uiController.toast(result.message or "...", if result.ok then "success" else "error")
				rebuild()
			end,
		})
		Theme.button({
			parent = row,
			text = if isEquipped then "Unequip" else "Equip",
			size = UDim2.new(0.48, 0, 0, 32),
			position = UDim2.new(0.52, 0, 1, -32),
			color = Theme.Colors.PanelLight,
			onClick = function()
				Remotes.getFunction("EquipBait"):InvokeServer(if isEquipped then nil else bait.id)
				rebuild()
			end,
		})
	end

	-- ===== Cosmetics (Pearls) =====
	sectionHeader("Cosmetics (Pearls — cosmetic only!)", 40)
	order = 41
	local racks: { { category: string, catalog: any, label: string } } = {
		{ category = "boatSkin", catalog = MonetizationConfig.BoatSkins, label = "Boat Skin" },
		{ category = "rodSkin", catalog = MonetizationConfig.RodSkins, label = "Rod Skin" },
		{ category = "pet", catalog = MonetizationConfig.Pets, label = "Crew Pet" },
	}
	for _, rack in racks do
		for itemId, item in rack.catalog do
			local ownedKey = rack.category .. "s"
			local owned = data.cosmetics[ownedKey] and data.cosmetics[ownedKey][itemId]
			local equipped = data.cosmetics.equipped[rack.category] == itemId
			local cost = item.pearlCost or item.premiumCost or 0
			local row = Theme.rowCard(content, 64, order)
			order += 1
			Theme.label({
				parent = row,
				text = `[{rack.label}] {item.displayName}{equipped and " ✓" or ""}`,
				size = UDim2.new(0.6, 0, 1, 0),
				bold = true,
			})
			Theme.button({
				parent = row,
				text = if not owned then `{cost} ⚪` elseif equipped then "Unequip" else "Equip",
				size = UDim2.new(0.38, 0, 0, 36),
				position = UDim2.new(0.62, 0, 0.5, -18),
				color = if owned then Theme.Colors.PanelLight else Theme.Colors.Accent,
				onClick = function()
					local result
					if not owned then
						result = Remotes.getFunction("BuyCosmetic"):InvokeServer(rack.category, itemId)
						uiController.toast(result.message or "...", if result.ok then "success" else "error")
					else
						Remotes.getFunction("EquipCosmetic")
							:InvokeServer(rack.category, if equipped then nil else itemId)
					end
					rebuild()
				end,
			})
		end
	end
end

function MarketUI.init(controller: any)
	uiController = controller
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "MarketModal",
		title = "🐟 Harbor Market",
		onClose = controller.close,
	})
	controller.registerModal("Market", {
		open = function()
			rebuild()
			overlay.Visible = true
		end,
		close = function()
			overlay.Visible = false
		end,
	})
end

return MarketUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">StormNavigationUI</string><ProtectedString name="Source">--!strict
-- Storm Navigation screen + in-run HUD. Modal starts the run; during the run
-- a compact strip shows the clock, gate count, and hazard hits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MiniGameConfig = require(Shared.Config.MiniGameConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.Parent.Controllers.ClientData)
local Theme = require(script.Parent.Theme)

local StormNavigationUI = {}

local GAME_ID = "StormNavigation"

local overlay: Frame
local content: ScrollingFrame
local uiController: any

local sessionStrip: Frame
local sessionLabel: TextLabel

local function sendAction(action: string)
	Remotes.getEvent("MiniGameAction"):FireServer(GAME_ID, action, nil)
end

local function rebuildModal()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local config = MiniGameConfig.Games.StormNavigation.config
	local data = ClientData.get()
	local best = data and data.miniGameHighScores and data.miniGameHighScores[GAME_ID] or 0

	Theme.label({
		parent = content,
		text = `Steer a loaner skiff through {config.checkpointCount} gates IN ORDER before the clock runs out. Rocks cost {math.floor(
			config.hitPenalty * 100
		)}% of the payout each.`,
		size = UDim2.new(1, 0, 0, 64),
		layoutOrder = 1,
	})
	Theme.label({
		parent = content,
		text = `Clean run pays {config.basePayout} 🪙 • {config.courseSeconds}s limit • Best time bonus: {Format.comma(
			best
		)}`,
		size = UDim2.new(1, 0, 0, 24),
		textColor = Theme.Colors.TextDim,
		layoutOrder = 2,
	})
	Theme.button({
		parent = content,
		text = "🌊 START RUN",
		color = Theme.Colors.Success,
		layoutOrder = 3,
		onClick = function()
			sendAction("Start")
			uiController.close()
		end,
	})
end

local function onState(state: any)
	if state.phase == "Active" then
		sessionStrip.Visible = true
		sessionLabel.Text =
			`⏱ {Format.clock(state.timeLeft)}  •  🚩 {state.checkpoints}/{state.totalCheckpoints}  •  💥 {state.hits}`
	elseif state.phase == "Done" then
		sessionStrip.Visible = false
		if state.finished then
			uiController.toast(
				`Course complete in {state.timeTaken}s ({state.hits} hits) — +{state.payout} 🪙!`,
				"success"
			)
		else
			uiController.toast(`Run over — +{state.payout} 🪙 consolation.`, "info")
		end
	end
end

function StormNavigationUI.init(controller: any)
	uiController = controller
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "StormNavigationModal",
		title = "🌩 Storm Navigation",
		onClose = controller.close,
	})
	controller.registerModal(`MiniGame_{GAME_ID}`, {
		open = function()
			rebuildModal()
			overlay.Visible = true
		end,
		close = function()
			overlay.Visible = false
		end,
	})

	sessionStrip = Instance.new("Frame")
	sessionStrip.Name = "StormStrip"
	sessionStrip.AnchorPoint = Vector2.new(0.5, 0)
	sessionStrip.Position = UDim2.new(0.5, 0, 0, 52)
	sessionStrip.Size = UDim2.fromOffset(320, 40)
	sessionStrip.BackgroundColor3 = Theme.Colors.Panel
	sessionStrip.BackgroundTransparency = 0.15
	sessionStrip.Visible = false
	Theme.corner(sessionStrip)
	sessionStrip.Parent = controller.getGui()

	sessionLabel = Theme.label({
		parent = sessionStrip,
		text = "",
		size = UDim2.new(1, -76, 1, 0),
		position = UDim2.new(0, 8, 0, 0),
		bold = true,
	})
	Theme.button({
		parent = sessionStrip,
		text = "Quit",
		size = UDim2.fromOffset(64, 32),
		position = UDim2.new(1, -68, 0.5, -16),
		color = Theme.Colors.Danger,
		onClick = function()
			sendAction("Abort")
		end,
	})

	Remotes.getEvent("MiniGameState").OnClientEvent:Connect(function(gameId, state)
		if gameId == GAME_ID then
			onState(state)
		end
	end)
end

return StormNavigationUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">Theme</string><ProtectedString name="Source">--!strict
-- Tiny programmatic UI kit. Mobile-first: every interactive element is at
-- least 44x44 pt equivalent, text is TextScaled, and screens are single-column
-- cards that fit phone aspect ratios. All UI in the game is built through
-- these helpers so a restyle is a one-file change.

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(24, 32, 44),
	Panel = Color3.fromRGB(34, 44, 60),
	PanelLight = Color3.fromRGB(46, 58, 78),
	Accent = Color3.fromRGB(64, 156, 255),
	Success = Color3.fromRGB(72, 190, 120),
	Danger = Color3.fromRGB(230, 90, 90),
	Gold = Color3.fromRGB(240, 195, 80),
	Pearl = Color3.fromRGB(220, 225, 240),
	Text = Color3.fromRGB(235, 240, 248),
	TextDim = Color3.fromRGB(160, 172, 190),
}

Theme.Font = Enum.Font.GothamMedium
Theme.FontBold = Enum.Font.GothamBold

function Theme.corner(parent: Instance, radius: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = parent
end

function Theme.padding(parent: Instance, pixels: number)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, pixels)
	pad.PaddingBottom = UDim.new(0, pixels)
	pad.PaddingLeft = UDim.new(0, pixels)
	pad.PaddingRight = UDim.new(0, pixels)
	pad.Parent = parent
end

function Theme.list(parent: Instance, gap: number?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, gap or 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

function Theme.label(props: {
	parent: Instance,
	text: string,
	size: UDim2,
	position: UDim2?,
	textColor: Color3?,
	bold: boolean?,
	alignX: Enum.TextXAlignment?,
	layoutOrder: number?,
}): TextLabel
	local labelInstance = Instance.new("TextLabel")
	labelInstance.BackgroundTransparency = 1
	labelInstance.Size = props.size
	labelInstance.Position = props.position or UDim2.new()
	labelInstance.Text = props.text
	labelInstance.TextColor3 = props.textColor or Theme.Colors.Text
	labelInstance.Font = if props.bold then Theme.FontBold else Theme.Font
	labelInstance.TextScaled = true
	labelInstance.TextXAlignment = props.alignX or Enum.TextXAlignment.Left
	labelInstance.LayoutOrder = props.layoutOrder or 0
	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MaxTextSize = 22
	sizeConstraint.Parent = labelInstance
	labelInstance.Parent = props.parent
	return labelInstance
end

-- Big tap-friendly button. Minimum height enforced for touch.
function Theme.button(props: {
	parent: Instance,
	text: string,
	size: UDim2?,
	position: UDim2?,
	color: Color3?,
	layoutOrder: number?,
	onClick: () -&gt; (),
}): TextButton
	local buttonInstance = Instance.new("TextButton")
	buttonInstance.Size = props.size or UDim2.new(1, 0, 0, 48)
	buttonInstance.Position = props.position or UDim2.new()
	buttonInstance.BackgroundColor3 = props.color or Theme.Colors.Accent
	buttonInstance.Text = props.text
	buttonInstance.TextColor3 = Theme.Colors.Text
	buttonInstance.Font = Theme.FontBold
	buttonInstance.TextScaled = true
	buttonInstance.AutoButtonColor = true
	buttonInstance.LayoutOrder = props.layoutOrder or 0
	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MaxTextSize = 20
	sizeConstraint.Parent = buttonInstance
	local minSize = Instance.new("UISizeConstraint")
	minSize.MinSize = Vector2.new(44, 44)
	minSize.Parent = buttonInstance
	Theme.corner(buttonInstance)
	buttonInstance.Activated:Connect(props.onClick)
	buttonInstance.Parent = props.parent
	return buttonInstance
end

-- Full-screen modal card with a title bar and close button.
-- Returns the content frame (with a UIListLayout) to fill.
function Theme.modal(props: {
	parent: Instance,
	name: string,
	title: string,
	onClose: () -&gt; (),
}): (Frame, ScrollingFrame)
	local overlay = Instance.new("Frame")
	overlay.Name = props.name
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0.45
	overlay.Visible = false
	overlay.ZIndex = 10
	overlay.Parent = props.parent

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	-- Phone-friendly: near-full-screen on small viewports, capped on desktop.
	card.Size = UDim2.fromScale(0.92, 0.85)
	card.BackgroundColor3 = Theme.Colors.Background
	card.ZIndex = 11
	local maxSize = Instance.new("UISizeConstraint")
	maxSize.MaxSize = Vector2.new(560, 720)
	maxSize.Parent = card
	Theme.corner(card, 14)
	card.Parent = overlay

	local titleBar = Instance.new("Frame")
	titleBar.Size = UDim2.new(1, 0, 0, 52)
	titleBar.BackgroundTransparency = 1
	titleBar.ZIndex = 12
	titleBar.Parent = card
	Theme.padding(titleBar, 8)

	local titleLabel = Theme.label({
		parent = titleBar,
		text = props.title,
		size = UDim2.new(1, -56, 1, 0),
		bold = true,
	})
	titleLabel.ZIndex = 12

	local closeButton = Instance.new("TextButton")
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, 0, 0, 0)
	closeButton.Size = UDim2.fromOffset(44, 44)
	closeButton.BackgroundColor3 = Theme.Colors.Danger
	closeButton.Text = "X"
	closeButton.TextColor3 = Theme.Colors.Text
	closeButton.Font = Theme.FontBold
	closeButton.TextSize = 20
	closeButton.ZIndex = 12
	Theme.corner(closeButton)
	closeButton.Activated:Connect(props.onClose)
	closeButton.Parent = titleBar

	local content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Position = UDim2.new(0, 0, 0, 56)
	content.Size = UDim2.new(1, 0, 1, -56)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 6
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.ZIndex = 11
	content.Parent = card
	Theme.padding(content, 12)
	Theme.list(content, 8)

	return overlay, content
end

-- Simple row card used inside modals (shop entries, dex entries...)
function Theme.rowCard(parent: Instance, heightPixels: number?, layoutOrder: number?): Frame
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, heightPixels or 64)
	row.BackgroundColor3 = Theme.Colors.Panel
	row.LayoutOrder = layoutOrder or 0
	row.ZIndex = 11
	Theme.corner(row)
	Theme.padding(row, 8)
	row.Parent = parent
	return row
end

return Theme
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">TreasureDivingUI</string><ProtectedString name="Source">--!strict
-- Treasure Diving screen + in-dive HUD. The modal (opened at the station)
-- explains the game and starts the dive; during the dive the modal closes and
-- a compact air-timer strip shows at the top of the screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MiniGameConfig = require(Shared.Config.MiniGameConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.Parent.Controllers.ClientData)
local Theme = require(script.Parent.Theme)

local TreasureDivingUI = {}

local GAME_ID = "TreasureDiving"

local overlay: Frame
local content: ScrollingFrame
local uiController: any

local sessionStrip: Frame
local sessionLabel: TextLabel

local function sendAction(action: string)
	Remotes.getEvent("MiniGameAction"):FireServer(GAME_ID, action, nil)
end

local function rebuildModal()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local config = MiniGameConfig.Games.TreasureDiving.config
	local data = ClientData.get()
	local best = data and data.miniGameHighScores and data.miniGameHighScores[GAME_ID] or 0

	Theme.label({
		parent = content,
		text = `Dive the sunken wreck and grab as many glowing chests as you can in {config.divingSeconds}s.`,
		size = UDim2.new(1, 0, 0, 48),
		layoutOrder = 1,
	})
	Theme.label({
		parent = content,
		text = `{config.payoutPerTreasure} 🪙 per chest • {config.treasureCount} chests down there • Best haul: {best}`,
		size = UDim2.new(1, 0, 0, 24),
		textColor = Theme.Colors.TextDim,
		layoutOrder = 2,
	})
	Theme.button({
		parent = content,
		text = "🤿 START DIVE",
		color = Theme.Colors.Success,
		layoutOrder = 3,
		onClick = function()
			sendAction("Start")
			uiController.close()
		end,
	})
end

local function onState(state: any)
	if state.phase == "Active" then
		sessionStrip.Visible = true
		sessionLabel.Text = `🫧 Air {Format.clock(state.timeLeft)}  •  💰 {state.collected}/{state.total}`
	elseif state.phase == "Done" then
		sessionStrip.Visible = false
		uiController.toast(
			`Dive over! {state.collected}/{state.total} chests — +{state.payout} 🪙`,
			if state.payout &gt; 0 then "success" else "info"
		)
	end
end

function TreasureDivingUI.init(controller: any)
	uiController = controller
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "TreasureDivingModal",
		title = "🤿 Treasure Diving",
		onClose = controller.close,
	})
	controller.registerModal(`MiniGame_{GAME_ID}`, {
		open = function()
			rebuildModal()
			overlay.Visible = true
		end,
		close = function()
			overlay.Visible = false
		end,
	})

	-- In-dive HUD strip (top-center) with a Surface button.
	sessionStrip = Instance.new("Frame")
	sessionStrip.Name = "DiveStrip"
	sessionStrip.AnchorPoint = Vector2.new(0.5, 0)
	sessionStrip.Position = UDim2.new(0.5, 0, 0, 52)
	sessionStrip.Size = UDim2.fromOffset(300, 40)
	sessionStrip.BackgroundColor3 = Theme.Colors.Panel
	sessionStrip.BackgroundTransparency = 0.15
	sessionStrip.Visible = false
	Theme.corner(sessionStrip)
	sessionStrip.Parent = controller.getGui()

	sessionLabel = Theme.label({
		parent = sessionStrip,
		text = "",
		size = UDim2.new(1, -84, 1, 0),
		position = UDim2.new(0, 8, 0, 0),
		bold = true,
	})
	Theme.button({
		parent = sessionStrip,
		text = "Surface",
		size = UDim2.fromOffset(72, 32),
		position = UDim2.new(1, -76, 0.5, -16),
		color = Theme.Colors.Danger,
		onClick = function()
			sendAction("Surface")
		end,
	})

	Remotes.getEvent("MiniGameState").OnClientEvent:Connect(function(gameId, state)
		if gameId == GAME_ID then
			onState(state)
		end
	end)
end

return TreasureDivingUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">UpgradeUI</string><ProtectedString name="Source">--!strict
-- Dockmaster screen: the boat tier ladder. Shows every tier, highlights the
-- current one, and offers the next upgrade. Opened by the dockmaster prompt;
-- the server re-validates proximity + funds on purchase.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local BoatConfig = require(Shared.Config.BoatConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Format = require(Shared.Util.Format)

local ClientData = require(script.Parent.Parent.Controllers.ClientData)
local Theme = require(script.Parent.Theme)

local UpgradeUI = {}

local overlay: Frame
local content: ScrollingFrame
local uiController: any

-- Zones unlocked at a given tier, for the tier card blurbs.
local function zonesUnlockedAt(tier: number): string
	local names = {}
	for _, zone in ZoneConfig.Zones do
		if zone.requiredBoatTier == tier then
			table.insert(names, zone.displayName)
		end
	end
	return #names &gt; 0 and ("Unlocks: " .. table.concat(names, ", ")) or ""
end

local function rebuild()
	for _, child in content:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local data = ClientData.get()
	if not data then
		return
	end

	for _, tierDef in BoatConfig.Tiers do
		local isCurrent = tierDef.tier == data.boatTier
		local isNext = tierDef.tier == data.boatTier + 1
		local isOwnedOrPast = tierDef.tier &lt;= data.boatTier

		local row = Theme.rowCard(content, if isNext then 116 else 84, tierDef.tier)
		if isCurrent then
			row.BackgroundColor3 = Theme.Colors.PanelLight
		end

		Theme.label({
			parent = row,
			text = `T{tierDef.tier} — {tierDef.displayName}` .. (isCurrent and "  (current)" or ""),
			size = UDim2.new(1, 0, 0, 24),
			bold = true,
			textColor = if isOwnedOrPast then Theme.Colors.Success else Theme.Colors.Text,
		})
		Theme.label({
			parent = row,
			text = `Speed {tierDef.speed} • Hold {tierDef.storage} fish • {tierDef.rodSlots} rod slot(s)`,
			size = UDim2.new(1, 0, 0, 18),
			position = UDim2.new(0, 0, 0, 24),
			textColor = Theme.Colors.TextDim,
		})
		local unlocks = zonesUnlockedAt(tierDef.tier)
		Theme.label({
			parent = row,
			text = if unlocks ~= "" then unlocks else tierDef.description,
			size = UDim2.new(1, 0, 0, 18),
			position = UDim2.new(0, 0, 0, 42),
			textColor = if unlocks ~= "" then Theme.Colors.Gold else Theme.Colors.TextDim,
		})

		if isNext then
			Theme.button({
				parent = row,
				text = `UPGRADE — {Format.comma(tierDef.cost)} 🪙`,
				size = UDim2.new(1, 0, 0, 40),
				position = UDim2.new(0, 0, 1, -40),
				color = if data.doubloons &gt;= tierDef.cost then Theme.Colors.Success else Theme.Colors.Danger,
				onClick = function()
					local result = Remotes.getFunction("UpgradeBoat"):InvokeServer()
					if not result.ok then
						uiController.toast(result.message or "Can't upgrade yet.", "error")
					end
					rebuild()
				end,
			})
		end
	end
end

function UpgradeUI.init(controller: any)
	uiController = controller
	overlay, content = Theme.modal({
		parent = controller.getGui(),
		name = "UpgradeModal",
		title = "⚓ Dockmaster — Boat Upgrades",
		onClose = controller.close,
	})
	controller.registerModal("UpgradeShop", {
		open = function()
			rebuild()
			overlay.Visible = true
		end,
		close = function()
			overlay.Visible = false
		end,
	})
end

return UpgradeUI
</ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX49"><Properties><string name="Name">Client</string><ProtectedString name="Source">--!strict
-- Client bootstrap. ClientData first (everything reads it), then the UI
-- controller (owns the ScreenGui), then feature controllers/screens.

local Controllers = script.Parent.Controllers
local UI = script.Parent.UI

local ClientData = require(Controllers.ClientData)
local UIController = require(Controllers.UIController)
local FishingController = require(Controllers.FishingController)
local MinimapController = require(Controllers.MinimapController)
local AmbienceController = require(Controllers.AmbienceController)

local MarketUI = require(UI.MarketUI)
local UpgradeUI = require(UI.UpgradeUI)
local DexUI = require(UI.DexUI)
local BattlePassUI = require(UI.BattlePassUI)
local CrabRacingUI = require(UI.CrabRacingUI)
local TreasureDivingUI = require(UI.TreasureDivingUI)
local StormNavigationUI = require(UI.StormNavigationUI)

ClientData.init()
UIController.init()
FishingController.init(UIController.getGui())
MinimapController.init(UIController.getGui())
AmbienceController.init()

MarketUI.init(UIController)
UpgradeUI.init(UIController)
DexUI.init(UIController)
BattlePassUI.init(UIController)
CrabRacingUI.init(UIController)
TreasureDivingUI.init(UIController)
StormNavigationUI.init(UIController)

print("[CruiseTycoon] Client initialized")
</ProtectedString></Properties></Item></Item></Item></Item></roblox>